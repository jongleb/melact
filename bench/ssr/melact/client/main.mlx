external document : Dom.document = "document"

external element_by_id : Dom.document -> string -> Dom.element option = "getElementById"
[@@mel.send] [@@mel.return nullable]

external parse : string -> Page.row array = "parse" [@@mel.scope "JSON"]
external mark : string -> unit = "mark" [@@mel.scope "performance"]
external window : < __hydrated : bool [@mel.set] > Js.t = "window"
external search : string = "search" [@@mel.scope "location"]

let () =
  mark "hydrate:start";
  Option.iter
    (fun root ->
      let rows = Option.fold ~none:[||] ~some:parse (Melhole.Served.data ~id:"model") in
      ignore
        (match search with
        | "?resume" -> ReactDOM.Client.resumeRoot root <Page.App rows />
        | _ -> ReactDOM.Client.hydrateRoot root <Page.App rows />);
      mark "hydrate:end";
      window##__hydrated #= true)
    (element_by_id document "main")
