type row = { id : int; label : string }

(** The row whose label was clicked last. *)
type selection = Unselected | Selected of int

type model = { rows : row array; next : int; seed : int; selection : selection }

type message = Run | Run_lots | Add | Update | Clear | Swap_rows | Select of int | Remove of int

let build model count =
  let adjectives =
    [| "pretty"; "large"; "big"; "small"; "tall"; "short"; "long"; "handsome"; "plain"; "quaint";
       "clean"; "elegant"; "easy"; "angry"; "crazy"; "helpful"; "mushy"; "odd"; "unsightly";
       "adorable"; "important"; "inexpensive"; "cheap"; "expensive"; "fancy" |]
  and colours =
    [| "red"; "yellow"; "blue"; "green"; "pink"; "brown"; "purple"; "brown"; "white"; "black";
       "orange" |]
  and nouns =
    [| "table"; "chair"; "house"; "bbq"; "desk"; "car"; "pony"; "cookie"; "sandwich"; "burger";
       "pizza"; "mouse"; "keyboard" |]
  in
  let step seed = ((seed * 1103515245) + 12345) land 0x3fffffff in
  let pick words seed = words.((seed lsr 8) mod Array.length words) in
  let rec rows made id seed count =
    match count with
    | 0 -> (Array.of_list (List.rev made), id, seed)
    | _ ->
        let adjective = step seed in
        let colour = step adjective in
        let noun = step colour in
        rows
          ({ id; label = pick adjectives adjective ^ " " ^ pick colours colour ^ " " ^ pick nouns noun }
          :: made)
          (id + 1) noun (count - 1)
  in
  rows [] model.next model.seed count

let update message model =
  match message with
  | Run ->
      let rows, next, seed = build model 1000 in
      { rows; next; seed; selection = Unselected }
  | Run_lots ->
      let rows, next, seed = build model 10000 in
      { rows; next; seed; selection = Unselected }
  | Add ->
      let rows, next, seed = build model 1000 in
      { model with rows = Array.append model.rows rows; next; seed }
  | Update ->
      {
        model with
        rows =
          Array.mapi
            (fun index row ->
              match index mod 10 with 0 -> { row with label = row.label ^ " !!!" } | _ -> row)
            model.rows;
      }
  | Clear -> { model with rows = [||]; selection = Unselected }
  | Swap_rows -> (
      match Array.length model.rows > 998 with
      | true ->
          let rows = Array.copy model.rows in
          rows.(1) <- model.rows.(998);
          rows.(998) <- model.rows.(1);
          { model with rows }
      | false -> model)
  | Select id -> { model with selection = Selected id }
  | Remove id -> (
      let count = Array.length model.rows in
      let rec found index = match index = count with true -> None | false -> if model.rows.(index).id = id then Some index else found (index + 1) in
      Option.fold ~none:model
        ~some:(fun index ->
          { model with rows = Array.append (Array.sub model.rows 0 index) (Array.sub model.rows (index + 1) (count - index - 1)) })
        (found 0))

let view { rows; selection; _ } =
  let button id title message =
    <div className="col-sm-6 smallpad">
      <button type_="button" className="btn btn-primary btn-block" id onClick=message>
        (Html.text title)
      </button>
    </div>
  in
  let row { id; label } =
    <tr
      key=(string_of_int id)
      className=(match selection with Selected chosen when chosen = id -> "danger" | _ -> "")>
      <td className="col-md-1">(Html.int id)</td>
      <td className="col-md-4"><a onClick=(Select id)>(Html.text label)</a></td>
      <td className="col-md-1">
        <a onClick=(Remove id)>
          <span className="glyphicon glyphicon-remove" ariaHidden=true />
        </a>
      </td>
      <td className="col-md-6" />
    </tr>
  in
  <div className="container">
    <div className="jumbotron">
      <div className="row">
        <div className="col-md-6"><h1>(Html.text "Meltea keyed")</h1></div>
        <div className="col-md-6">
          <div className="row">
            (button "run" "Create 1,000 rows" Run)
            (button "runlots" "Create 10,000 rows" Run_lots)
            (button "add" "Append 1,000 rows" Add)
            (button "update" "Update every 10th row" Update)
            (button "clear" "Clear" Clear)
            (button "swaprows" "Swap Rows" Swap_rows)
          </div>
        </div>
      </div>
    </div>
    <table className="table table-hover table-striped test-data">
      <tbody>(Html.array (Array.map row rows))</tbody>
    </table>
    <span className="preloadicon glyphicon glyphicon-remove" ariaHidden=true />
  </div>

let init ~seed = { rows = [||]; next = 1; seed; selection = Unselected }
