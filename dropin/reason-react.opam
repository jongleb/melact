opam-version: "2.0"
version: "0.17.0+melact"
synopsis:
  "Melact under reason-react's name, for apps and libraries that depend on reason-react"
description:
  "Pinned in place of reason-react, this package gives every library that lists (libraries reason-react) Melact's React, ReactDOM, ReactDOMServer, ReactDOMTestUtils, ReasonReactRouter and ReasonReactErrorBoundary, so that a whole build, its opam dependencies included, runs on Melact."
maintainer: ["Gleb <jongleber@gmail.com>"]
authors: ["Gleb <jongleber@gmail.com>"]
license: "MIT"
homepage: "https://jongleb.github.io/melact-meltea-sites/melact/"
bug-reports: "https://github.com/jongleb/melact/issues"
depends: [
  "dune" {>= "3.16" & >= "3.16"}
  "melact"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/jongleb/melact.git"
