# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "The JSX and [@react.component] of reason-react, compiled to templates, for Melact"
maintainer: ["Gleb"]
authors: ["Gleb"]
license: "MIT"
homepage: "https://github.com/jongleb/melact"
bug-reports: "https://github.com/jongleb/melact/issues"
depends: [
  "ocaml" {>= "5.3"}
  "dune" {>= "3.16" & >= "3.16"}
  "ppxlib" {>= "0.34"}
  "melhole"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/jongleb/melact.git"
