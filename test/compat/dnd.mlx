(* A board of cards and bins with react-dnd, as the team writes it through its bindings: useDrag and
   useDrop called from OCaml components, DndProvider around them. Built with reason-react on npm's React 18
   and with Melact, where react-dnd runs on melact.compat; test/compat/dnd.test.mjs drags with react-dnd's
   test backend. *)

(** What react-dnd makes a backend from. *)
type backend_factory

(** react-dnd's manager of one board, whose backend the test drives. *)
type manager

(** What react-dnd's collect functions read. *)
type monitor = < getHandlerId : unit -> string [@mel.meth] ; isDragging : unit -> bool [@mel.meth] ; isOver : unit -> bool [@mel.meth] > Js.t

(** What a card carries while it is dragged. *)
type item = < id : string > Js.t

external test_backend : backend_factory = "TestBackend" [@@mel.module "react-dnd-test-backend"]
external create_manager : backend_factory -> manager = "createDragDropManager" [@@mel.module "dnd-core"]

module DndProvider = struct
  external make : manager:manager -> children:React.element -> React.element = "DndProvider"
  [@@mel.module "react-dnd"] [@@react.component]
end

(** What a drag source shows: its handler id and whether it is dragged. *)
type dragged = < handler : string ; dragging : bool > Js.t

(** What a drop target shows: its handler id and whether a card is over it. *)
type hovered = < handler : string ; over : bool > Js.t

external use_drag :
  (unit ->
  < _type : string ; item : item ; collect : monitor -> dragged > Js.t) ->
  string array ->
  dragged * (Dom.element Js.Nullable.t -> unit) * (Dom.element Js.Nullable.t -> unit) = "useDrag"
[@@mel.module "react-dnd"]

external use_drop :
  (unit -> < accept : string ; drop : item -> unit ; collect : monitor -> hovered > Js.t) ->
  string array ->
  hovered * (Dom.element Js.Nullable.t -> unit) = "useDrop"
[@@mel.module "react-dnd"]

module Card = struct
  let[@react.component] make ~id ~log =
    let collected, drag, _ =
      use_drag
        (fun () ->
          [%mel.obj
            {
              _type = "card";
              item = [%mel.obj { id }];
              collect = (fun monitor -> [%mel.obj { handler = monitor##getHandlerId (); dragging = monitor##isDragging () }]);
            }])
        [| id |]
    in
    React.useEffect1
      (fun () ->
        log ("card " ^ id ^ " dragging " ^ string_of_bool collected##dragging);
        None)
      [| collected##dragging |];
    <div className="card" ref=(ReactDOM.Ref.callbackDomRef drag) title=id id=collected##handler>
      (React.string (id ^ (match collected##dragging with true -> " (dragging)" | false -> "")))
    </div>
end

module Bin = struct
  let[@react.component] make ~name ~cards ~onDrop ~log =
    let collected, drop =
      use_drop
        (fun () ->
          [%mel.obj
            {
              accept = "card";
              drop = (fun item -> onDrop item##id);
              collect = (fun monitor -> [%mel.obj { handler = monitor##getHandlerId (); over = monitor##isOver () }]);
            }])
        [| name |]
    in
    <section className="bin" ref=(ReactDOM.Ref.callbackDomRef drop) title=name id=collected##handler>
      <h2>(React.string (name ^ (match collected##over with true -> " (over)" | false -> "")))</h2>
      (React.array (Array.map (fun id -> <Card key=id id log />) cards))
    </section>
end

module Board = struct
  let[@react.component] make ~manager ~log =
    let left, setLeft = React.useState (fun () -> [| "a"; "b"; "c" |]) in
    let right, setRight = React.useState (fun () -> [||]) in
    let moved id =
      log ("drop " ^ id);
      setLeft (fun cards -> Array.of_list (List.filter (fun other -> not (String.equal other id)) (Array.to_list cards)));
      setRight (fun cards -> Array.of_list (List.filter (fun other -> not (String.equal other id)) (Array.to_list cards)))
    in
    <DndProvider manager>
      <div className="board">
        <Bin name="left" cards=left log onDrop=(fun id -> moved id; setLeft (fun cards -> Array.append cards [| id |])) />
        <Bin name="right" cards=right log onDrop=(fun id -> moved id; setRight (fun cards -> Array.append cards [| id |])) />
      </div>
    </DndProvider>
end

let mount_board root log =
  let manager = create_manager test_backend in
  let client = ReactDOM.Client.createRoot root in
  ReactDOM.Client.render client <Board manager log />;
  (client, manager)

let unmount_board (client, _) = ReactDOM.Client.unmount client ()
