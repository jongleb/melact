(* A dashboard of recharts charts, written as the team writes it: the chart components bound in one file,
   data and toggles in OCaml state, a legend whose labels OCaml renders. Built with reason-react on npm's
   React 18 and with Melact on islands; test/compat/charts.test.mjs drives both. *)

(** A point of the charts' data. *)
type point = < name : string ; a : int ; b : int > Js.t

module LineChart = struct
  external make : data:point array -> width:int -> height:int -> children:React.element -> React.element = "LineChart"
  [@@mel.module "recharts"] [@@react.component]
end

module BarChart = struct
  external make : data:point array -> width:int -> height:int -> children:React.element -> React.element = "BarChart"
  [@@mel.module "recharts"] [@@react.component]
end

module Line = struct
  external make : dataKey:string -> stroke:string -> isAnimationActive:bool -> React.element = "Line"
  [@@mel.module "recharts"] [@@react.component]
end

module Bar = struct
  external make : dataKey:string -> fill:string -> isAnimationActive:bool -> React.element = "Bar"
  [@@mel.module "recharts"] [@@react.component]
end

module XAxis = struct
  external make : dataKey:string -> React.element = "XAxis" [@@mel.module "recharts"] [@@react.component]
end

module YAxis = struct
  external make : unit -> React.element = "YAxis" [@@mel.module "recharts"] [@@react.component]
end

module CartesianGrid = struct
  external make : strokeDasharray:string -> React.element = "CartesianGrid" [@@mel.module "recharts"] [@@react.component]
end

module Legend = struct
  external make : formatter:(string -> Js.Json.t -> int -> React.element) -> React.element = "Legend"
  [@@mel.module "recharts"] [@@react.component]
end

let point name a b : point = [%mel.obj { name; a; b }]

(** Which chart shows the data. *)
type kind = Lines | Bars

(** Whether series [b] is drawn. *)
type second = Shown | Hidden

module Dashboard = struct
  let[@react.component] make ~(log : string -> unit) =
    ignore log;
    let data, setData = React.useState (fun () -> [| point "p0" 4 7; point "p1" 9 3; point "p2" 6 5 |]) in
    let kind, setKind = React.useState (fun () -> Lines) in
    let second, setSecond = React.useState (fun () -> Shown) in
    let suffix, setSuffix = React.useState (fun () -> "") in
    let label value _ index = <span className="label">(React.string (value ^ suffix ^ " " ^ string_of_int index))</span>
    in
    let series =
      match (kind, second) with
      | Lines, Shown ->
          [ <Line key="a" dataKey="a" stroke="#c33" isAnimationActive=false />; <Line key="b" dataKey="b" stroke="#33c" isAnimationActive=false /> ]
      | Lines, Hidden -> [ <Line key="a" dataKey="a" stroke="#c33" isAnimationActive=false /> ]
      | Bars, Shown -> [ <Bar key="a" dataKey="a" fill="#c33" isAnimationActive=false />; <Bar key="b" dataKey="b" fill="#33c" isAnimationActive=false /> ]
      | Bars, Hidden -> [ <Bar key="a" dataKey="a" fill="#c33" isAnimationActive=false /> ]
    in
    <div className="dashboard">
      <button className="add" onClick=(fun _ ->
          setData (fun data -> Array.append data [| point ("p" ^ string_of_int (Array.length data)) (Array.length data * 3 mod 10) (Array.length data * 7 mod 10) |]))>
        (React.string "add")
      </button>
      <button className="drop" onClick=(fun _ -> setData (fun data -> match Array.length data with 0 | 1 -> data | length -> Array.sub data 0 (length - 1)))>
        (React.string "drop")
      </button>
      <button className="raise" onClick=(fun _ -> setData (fun data -> Array.mapi (fun index (p : point) -> match index with 0 -> point p##name (p##a + 1) p##b | _ -> p) data))>
        (React.string "raise")
      </button>
      <button className="kind" onClick=(fun _ -> setKind (fun kind -> match kind with Lines -> Bars | Bars -> Lines))>(React.string "kind")</button>
      <button className="second" onClick=(fun _ -> setSecond (fun second -> match second with Shown -> Hidden | Hidden -> Shown))>(React.string "second")</button>
      <button className="suffix" onClick=(fun _ -> setSuffix (fun suffix -> suffix ^ "!"))>(React.string "suffix")</button>
      (match kind with
      | Lines ->
          <LineChart data width=400 height=200>
            <CartesianGrid strokeDasharray="3 3" />
            <XAxis dataKey="name" />
            <YAxis />
            <Legend formatter=label />
            (React.array (Array.of_list series))
          </LineChart>
      | Bars ->
          <BarChart data width=400 height=200>
            <CartesianGrid strokeDasharray="3 3" />
            <XAxis dataKey="name" />
            <YAxis />
            <Legend formatter=label />
            (React.array (Array.of_list series))
          </BarChart>)
    </div>
end

let mount_dashboard root log =
  let client = ReactDOM.Client.createRoot root in
  ReactDOM.Client.render client <Dashboard log />;
  client

let unmount_dashboard client = ReactDOM.Client.unmount client ()
