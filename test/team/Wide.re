// The team's wide-guard: one dynamic attribute that reads 30 props must compile in linear time; the same props
// also feed a title and a text child.
[@react.component]
let make = (~p0, ~p1, ~p2, ~p3, ~p4, ~p5, ~p6, ~p7, ~p8, ~p9, ~p10, ~p11, ~p12, ~p13, ~p14, ~p15, ~p16, ~p17, ~p18, ~p19, ~p20, ~p21, ~p22, ~p23, ~p24, ~p25, ~p26, ~p27, ~p28, ~p29) =>
  <div className={"wide " ++ p0 ++ " " ++ p1 ++ " " ++ p2 ++ " " ++ p3 ++ " " ++ p4 ++ " " ++ p5 ++ " " ++ p6 ++ " " ++ p7 ++ " " ++ p8 ++ " " ++ p9 ++ " " ++ p10 ++ " " ++ p11 ++ " " ++ p12 ++ " " ++ p13 ++ " " ++ p14 ++ " " ++ p15 ++ " " ++ p16 ++ " " ++ p17 ++ " " ++ p18 ++ " " ++ p19 ++ " " ++ p20 ++ " " ++ p21 ++ " " ++ p22 ++ " " ++ p23 ++ " " ++ p24 ++ " " ++ p25 ++ " " ++ p26 ++ " " ++ p27 ++ " " ++ p28 ++ " " ++ p29} title={p0 ++ " " ++ p1 ++ " " ++ p2 ++ " " ++ p3 ++ " " ++ p4 ++ " " ++ p5 ++ " " ++ p6 ++ " " ++ p7 ++ " " ++ p8 ++ " " ++ p9 ++ " " ++ p10 ++ " " ++ p11 ++ " " ++ p12 ++ " " ++ p13 ++ " " ++ p14 ++ " " ++ p15 ++ " " ++ p16 ++ " " ++ p17 ++ " " ++ p18 ++ " " ++ p19 ++ " " ++ p20 ++ " " ++ p21 ++ " " ++ p22 ++ " " ++ p23 ++ " " ++ p24 ++ " " ++ p25 ++ " " ++ p26 ++ " " ++ p27 ++ " " ++ p28 ++ " " ++ p29}> {React.string(p0 ++ " " ++ p1 ++ " " ++ p2 ++ " " ++ p3 ++ " " ++ p4 ++ " " ++ p5 ++ " " ++ p6 ++ " " ++ p7 ++ " " ++ p8 ++ " " ++ p9 ++ " " ++ p10 ++ " " ++ p11 ++ " " ++ p12 ++ " " ++ p13 ++ " " ++ p14 ++ " " ++ p15 ++ " " ++ p16 ++ " " ++ p17 ++ " " ++ p18 ++ " " ++ p19 ++ " " ++ p20 ++ " " ++ p21 ++ " " ++ p22 ++ " " ++ p23 ++ " " ++ p24 ++ " " ++ p25 ++ " " ++ p26 ++ " " ++ p27 ++ " " ++ p28 ++ " " ++ p29)} </div>;
