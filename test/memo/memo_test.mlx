open Testing

external test_async : string -> (unit -> unit Js.Promise.t) -> unit = "test"
external adopt : unit Js.Promise.t -> unit Js.Promise.t = "resolve" [@@mel.scope "Promise"]

let ( let* ) promise next = Js.Promise.then_ next promise
let act run = adopt (React.act run)

(** What the parent holds: [near] is captured by the cached props, [far] only through its parity. *)
type state = { near : int; far : int }

let send = ref (fun (_ : state -> state) -> ())
let renders = ref 0
let outside = ref 0

module Shown = struct
  let[@react.component] make ~onPick ~pair ~tags ~parity ~children =
    incr renders;
    <p onClick=(fun _ -> onPick ())>
      (React.string (fst pair ^ string_of_int (snd pair) ^ String.concat "" (Array.to_list tags) ^ string_of_int parity))
      children
    </p>
end

module Parent = struct
  let[@react.component] make ~volatile =
    let state, setState = React.useState (fun () -> { near = 0; far = 0 }) in
    send := setState;
    let { near; far } = state in
    match volatile with
    | `Captures_state ->
        <div>
          <Shown onPick=(fun () -> setState (fun current -> { current with near = current.near + near })) pair=("n", near) tags=[| "t" |] parity=(far mod 2)>
            <b>(React.int near)</b>
          </Shown>
          <span>(React.int far)</span>
        </div>
    | `Reads_a_ref ->
        <div>
          <Shown onPick=(fun () -> ()) pair=("n", near) tags=[| string_of_int !outside |] parity=(far mod 2)><b>(React.int near)</b></Shown>
          <span>(React.int far)</span>
        </div>
end

let computed = ref 0
let let_send = ref (fun (_ : state -> state) -> ())

let counted near =
  incr computed;
  Array.init 3 (fun index -> near + index)

module Lets = struct
  let[@react.component] make ~mutated =
    let state, setState = React.useState (fun () -> { near = 0; far = 0 }) in
    let_send := setState;
    let { near; far } = state in
    let numbers = counted near in
    let shown = Array.fold_left (fun sum value -> sum + value) 0 numbers in
    match mutated with
    | `Read_only -> <p>(React.int shown)(React.string "/")(React.int far)</p>
    | `Written ->
        let total = ref (counted near |> Array.length) in
        total := !total + far;
        <p>(React.int shown)(React.string "/")(React.int !total)</p>
end

let let_law mutated expected =
  check_async
    (async_property (tapes ~shortest:4 ~longest:40) (fun values ->
         let tape = tape values in
         let root = attached () in
         let client = ReactDOM.Client.createRoot root in
         let* () = act (fun () -> ReactDOM.Client.render client <Lets mutated />) in
         let rec step remaining (state : state) seen =
           match remaining with
           | 0 ->
               let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
               expect (List.map fst seen) |. to_equal (List.map snd seen);
               Js.Promise.resolve ()
           | _ ->
               let next =
                 match draw tape 2 with 0 -> { state with near = draw tape 3 } | _ -> { state with far = draw tape 3 }
               in
               computed := 0;
               let* () = act (fun () -> !let_send (fun _ -> next)) in
               let shown = (3 * next.near) + 3 in
               let text =
                 string_of_int shown ^ "/" ^ string_of_int (match mutated with `Read_only -> next.far | `Written -> 3 + next.far)
               in
               step (remaining - 1) next (((!computed, text_content root), (expected state next, text)) :: seen)
         in
         step 10 { near = 0; far = 0 } []))
    [%mel.obj { numRuns = 150 }]

external console_object : prototype = "console"
external bounding : Dom.element -> < top : float > Js.t = "getBoundingClientRect" [@@mel.send]
external page : Dom.element = "body" [@@mel.scope "document"]

(** Where a component reads layout. *)
type reading = In_body | In_hole | In_layout_effect | In_ref | In_handler

let readings = [| In_body; In_hole; In_layout_effect; In_ref; In_handler |]
let reading_send = ref (fun (_ : int -> int) -> ())

let useReader reading =
  let count, setCount = React.useState (fun () -> 0) in
  reading_send := setCount;
  let top () = (bounding page)##top in
  let body = match reading with In_body -> top () | In_hole | In_layout_effect | In_ref | In_handler -> 0. in
  React.useLayoutEffect1 (fun () -> (match reading with In_layout_effect -> ignore (top ()) | In_body | In_hole | In_ref | In_handler -> ()); None) [| count |];
  <p
    ref=(ReactDOM.Ref.callbackDomRef (fun element ->
         match (reading, Js.Nullable.toOption element) with
         | In_ref, Some _ -> ignore (top ())
         | In_ref, None | (In_body | In_hole | In_layout_effect | In_handler), _ -> ()))
    onClick=(fun _ -> match reading with In_handler -> ignore (top ()) | In_body | In_hole | In_layout_effect | In_ref -> ())>
    (React.float (body +. match reading with In_hole -> (bounding page)##top +. float_of_int count | In_body | In_layout_effect | In_ref | In_handler -> float_of_int count))
  </p>

module Body_reader = struct
  let[@react.component] make () = useReader In_body
end

module Hole_reader = struct
  let[@react.component] make () = useReader In_hole
end

module Effect_reader = struct
  let[@react.component] make () = useReader In_layout_effect
end

module Ref_reader = struct
  let[@react.component] make () = useReader In_ref
end

module Handler_reader = struct
  let[@react.component] make () = useReader In_handler
end

let reader reading =
  match reading with
  | In_body -> <Body_reader />
  | In_hole -> <Hole_reader />
  | In_layout_effect -> <Effect_reader />
  | In_ref -> <Ref_reader />
  | In_handler -> <Handler_reader />

let warned_before = ref []

let law volatile expected =
  check_async
    (async_property (tapes ~shortest:4 ~longest:40) (fun values ->
         let tape = tape values in
         let root = attached () in
         let client = ReactDOM.Client.createRoot root in
         let* () = act (fun () -> ReactDOM.Client.render client <Parent volatile />) in
         let rec step remaining (state : state) seen =
           match remaining with
           | 0 ->
               let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
               expect (List.map fst seen) |. to_equal (List.map snd seen);
               Js.Promise.resolve ()
           | _ ->
               let next =
                 match draw tape 2 with
                 | 0 -> { state with near = draw tape 3 }
                 | _ -> { state with far = draw tape 4 }
               in
               renders := 0;
               let* () = act (fun () -> !send (fun _ -> next)) in
               step (remaining - 1) next ((!renders, expected state next) :: seen)
         in
         step 10 { near = 0; far = 0 } []))
    [%mel.obj { numRuns = 150 }]

let () =
  MelactDebug.warnLayoutReadsInRender ();
  describe "layout read while rendering" (fun () ->
      test_async "warns once per component for a read in its body or a hole, never for one in an effect, a ref or a handler" (fun () ->
          check_async
            (async_property (tapes ~shortest:2 ~longest:8) (fun values ->
                 let tape = tape values in
                 let reading = readings.(draw tape (Array.length readings)) in
                 let warned = spy_on console_object "warn" in
                 let root = attached () in
                 let client = ReactDOM.Client.createRoot root in
                 let* () = act (fun () -> ReactDOM.Client.render client (reader reading)) in
                 let rec step remaining =
                   match remaining with
                   | 0 -> Js.Promise.resolve ()
                   | _ ->
                       let* () = act (fun () -> !reading_send (fun count -> count + 1)) in
                       let* () = act (fun () -> click (select root "p")) in
                       step (remaining - 1)
                 in
                 let* () = step (1 + draw tape 4) in
                 let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
                 let count = Array.length (calls (mock warned)) in
                 restore warned;
                 let expected =
                   match (reading, List.mem reading !warned_before) with
                   | (In_body | In_hole), false -> 1
                   | (In_body | In_hole), true | (In_layout_effect | In_ref | In_handler), _ -> 0
                 in
                 warned_before := reading :: !warned_before;
                 expect count |. to_equal expected;
                 Js.Promise.resolve ()))
            [%mel.obj { numRuns = 60 }]));
  describe "props written inline in a component" (fun () ->
      test_async "a child whose props capture nothing that changed, and are equal otherwise, is not rendered again"
        (fun () ->
          law `Captures_state (fun before after ->
              match (before.near = after.near, before.far mod 2 = after.far mod 2) with true, true -> 0 | _ -> 1));
      test_async "a let computed in the body runs again only when what it reads changed" (fun () ->
          let_law `Read_only (fun before after -> match before.near = after.near with true -> 0 | false -> 1));
      test_async "a let whose value is changed in place afterwards is computed on every render" (fun () ->
          let_law `Written (fun before after -> match before.near = after.near with true -> 1 | false -> 2));
      test_async "a value that reads mutable state while rendering is made again on every render" (fun () ->
          law `Reads_a_ref (fun _ _ -> 1)))

(** A row as its parent makes it afresh on every render: the view reads [title] and [count] only. *)
type entry = { title : string; count : int; note : string }

let entry_renders = ref 0
let entry_send = ref (fun (_ : entry -> entry) -> ())

module Entry_view = struct
  let[@react.component] make ~entry =
    let marked, _ = React.useState (fun () -> "") in
    incr entry_renders;
    <p>(React.string (entry.title ^ string_of_int entry.count ^ marked))</p>
end

let noted entry = entry.title ^ ":" ^ entry.note

module Entry_whole = struct
  let[@react.component] make ~entry =
    let marked, _ = React.useState (fun () -> "") in
    <i>(React.string (noted entry ^ marked))</i>
end

module Entry_default = struct
  let[@react.component] make ~entry ?(heading = entry.title) () =
    let marked, _ = React.useState (fun () -> "") in
    <s>(React.string (heading ^ marked))</s>
end

module Entry_parent = struct
  let[@react.component] make () =
    let entry, setEntry = React.useState (fun () -> { title = "a"; count = 0; note = "" }) in
    entry_send := setEntry;
    <div>
      <Entry_view entry=({ title = entry.title; count = entry.count; note = entry.note }) />
      <Entry_whole entry=({ title = entry.title; count = entry.count; note = entry.note }) />
      <Entry_default entry=({ title = entry.title; count = entry.count; note = entry.note }) />
    </div>
end

let () =
  describe "a prop read only through its fields" (fun () ->
      test_async "is guarded by those fields: a fresh record with the same fields does not render the child again" (fun () ->
          check_async
            (async_property (tapes ~shortest:1 ~longest:12) (fun values ->
                 let tape = tape values in
                 let root = attached () in
                 let client = ReactDOM.Client.createRoot root in
                 let* () = act (fun () -> ReactDOM.Client.render client <Entry_parent />) in
                 let rec step remaining current expected =
                   match remaining with
                   | 0 ->
                       let shown = text_content root in
                       let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
                       expect (shown, !entry_renders)
                       |. to_equal (current.title ^ string_of_int current.count ^ current.title ^ ":" ^ current.note ^ current.title, expected);
                       Js.Promise.resolve ()
                   | _ ->
                       let next =
                         match draw tape 3 with
                         | 0 -> { current with title = [| "a"; "b" |].(draw tape 2) }
                         | 1 -> { current with count = draw tape 3 }
                         | _ -> { current with note = string_of_int (draw tape 1000) }
                       in
                       let* () = act (fun () -> !entry_send (fun _ -> next)) in
                       step (remaining - 1) next
                         (expected + match (String.equal current.title next.title, current.count = next.count) with true, true -> 0 | _ -> 1)
                 in
                 entry_renders := 0;
                 let* () = Js.Promise.resolve () in
                 step 8 { title = "a"; count = 0; note = "" } 0))
            [%mel.obj { numRuns = 60 }]))
