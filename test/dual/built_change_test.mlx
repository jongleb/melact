[@@@alert "-deprecated"]
open Testing

external test_async : string -> (unit -> unit Js.Promise.t) -> unit = "test"
external adopt : unit Js.Promise.t -> unit Js.Promise.t = "resolve" [@@mel.scope "Promise"]
external bubbling : string -> < bubbles : bool > Js.t -> Dom.event = "Event" [@@mel.new]

let ( let* ) promise next = Js.Promise.then_ next promise
let act run = adopt (React.act run)
let events = ref []
let log event = events := event :: !events

let take () =
  let taken = List.rev !events in
  events := [];
  taken

let put_value : Dom.element -> string -> unit =
  [%mel.raw
    {|function (element, value) {
        Object.getOwnPropertyDescriptor(Object.getPrototypeOf(element), "value").set.call(element, value);
      }|}]

(** Fields made by [ReactDOM.createElement], which the compiler does not see; alone in its file, so
    that its fields are the first to listen for React's [onChange]. *)
module Changing = struct
  let[@react.component] make () =
    let text, setText = React.useState (fun () -> "") in
    let area, setArea = React.useState (fun () -> "") in
    let checked, setChecked = React.useState (fun () -> false) in
    let field tag id value set label =
      ReactDOM.createElement tag
        ~props:
          (ReactDOM.domProps ~id ~value
             ~onChange:(fun event ->
               let value = (React.Event.Form.target event)##value in
               log (label ^ " " ^ value);
               set (fun _ -> value))
             ())
        [||]
    in
    ReactDOM.createElement "div" ~props:(ReactDOM.domProps ())
      [|
        field "input" "text" text setText "text";
        field "textarea" "area" area setArea "area";
        ReactDOM.createElement "input"
          ~props:
            (ReactDOM.domProps ~id:"check" ~type_:"checkbox" ~checked
               ~onChange:(fun event ->
                 let value = (React.Event.Form.target event)##checked in
                 log ("check " ^ string_of_bool value);
                 setChecked (fun _ -> value))
               ())
          [||];
        ReactDOM.createElement "p" ~props:(ReactDOM.domProps ())
          [| React.string (text ^ "|" ^ area ^ "|" ^ string_of_bool checked) |];
      |]
end

let () =
  describe "onChange on fields made by ReactDOM.createElement" (fun () ->
      test_async "fires as React's does: on a changed value of an input or textarea, on a click of a checkbox" (fun () ->
          check_async
            (async_property (tapes ~shortest:2 ~longest:30) (fun values ->
                 let tape = tape values in
                 let root = attached () in
                 let client = ReactDOM.Client.createRoot root in
                 let* () = act (fun () -> ReactDOM.Client.render client <Changing />) in
                 ignore (take ());
                 let words = [| "a"; "b"; "ab" |] in
                 let fire element name = dispatch element (bubbling name [%mel.obj { bubbles = true }]) in
                 let rec step remaining (text, area, checked) expected =
                   match remaining with
                   | 0 ->
                       let shown = text_content (select root "p") in
                       let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
                       expect (shown, take ()) |. to_equal (text ^ "|" ^ area ^ "|" ^ string_of_bool checked, List.rev expected);
                       Js.Promise.resolve ()
                   | _ ->
                       let field, last, label = match draw tape 2 with 0 -> ("#text", text, "text") | _ -> ("#area", area, "area") in
                       let next word = match label with "text" -> (word, area, checked) | _ -> (text, word, checked) in
                       let typed name =
                         let word = words.(draw tape 3) in
                         ( (fun () ->
                             put_value (select root field) word;
                             fire (select root field) name),
                           next word,
                           match String.equal word last with true -> expected | false -> (label ^ " " ^ word) :: expected )
                       in
                       let run, model, expected =
                         match draw tape 4 with
                         | 0 -> typed "input"
                         | 1 -> typed "change"
                         | 2 -> ((fun () -> fire (select root field) "change"), (text, area, checked), expected)
                         | _ ->
                             ( (fun () -> click (select root "#check")),
                               (text, area, not checked),
                               ("check " ^ string_of_bool (not checked)) :: expected )
                       in
                       let* () = act run in
                       step (remaining - 1) model expected
                 in
                 step 8 ("", "", false) []))
            [%mel.obj { numRuns = 80 }]))
