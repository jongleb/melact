open Testing

external test_async : string -> (unit -> unit Js.Promise.t) -> unit = "test"
external tag_name : Dom.element -> string = "tagName" [@@mel.get]
external namespace_uri : Dom.element -> string = "namespaceURI" [@@mel.get]
external get_attribute : Dom.element -> string -> string = "getAttribute" [@@mel.send]
external select_all : Dom.element -> string -> Dom.nodeList = "querySelectorAll" [@@mel.send]
external element_of : Dom.node -> Dom.element = "%identity"
external window_object : prototype = "window"

external adopt : unit Js.Promise.t -> unit Js.Promise.t = "resolve" [@@mel.scope "Promise"]

let ( let* ) promise next = Js.Promise.then_ next promise
let act run = adopt (React.act run)
let events = ref []
let log event = events := event :: !events

let take () =
  let taken = List.rev !events in
  events := [];
  taken

let mount element =
  let root = attached () in
  let client = ReactDOM.Client.createRoot root in
  let* () = act (fun () -> ReactDOM.Client.render client element) in
  ignore (take ());
  Js.Promise.resolve (root, client)

let finish () = Js.Promise.resolve ()

module Counter = struct
  let[@react.component] make ~label =
    let count, setCount = React.useState (fun () -> 0) in
    log ("render " ^ label);
    <button onClick=(fun _ -> setCount (fun n -> n + 1))>
      (React.string (label ^ string_of_int count))
    </button>
end

module Plain_a = struct
  let[@react.component] make () = <section><Counter label="a" /></section>
end

module Plain_b = struct
  let[@react.component] make () = <section><Counter label="a" /></section>
end

module Switch = struct
  let[@react.component] make () =
    let first, setFirst = React.useState (fun () -> true) in
    <div>
      (if first then <Plain_a /> else <Plain_b />)
      <i onClick=(fun _ -> setFirst (fun first -> not first))>(React.string "swap")</i>
    </div>
end

module Quiet = struct
  let[@react.component] make = React.memo (fun ~label ->
    log ("render quiet " ^ label);
    <span>(React.string label)</span>)
end

module Parent = struct
  let[@react.component] make () =
    let n, setN = React.useState (fun () -> 0) in
    log "render parent";
    <div>
      <button onClick=(fun _ -> setN (fun n -> n + 1))>(React.int n)</button>
      <Quiet label="fixed" />
      <Quiet label=(if n > 0 then "moved" else "still") />
    </div>
end

module Effects = struct
  let[@react.component] make ~name ~dep =
    React.useLayoutEffect0 (fun () ->
      log ("layout " ^ name);
      Some (fun () -> log ("layout cleanup " ^ name)));
    React.useEffect0 (fun () ->
      log ("passive " ^ name);
      Some (fun () -> log ("passive cleanup " ^ name)));
    React.useEffect1 (fun () ->
      log ("deps " ^ name ^ " " ^ dep);
      Some (fun () -> log ("deps cleanup " ^ name ^ " " ^ dep)))
      [| dep |];
    React.null
end

module Effect_tree = struct
  let[@react.component] make () =
    let dep, setDep = React.useState (fun () -> "a") in
    <div>
      <button onClick=(fun _ -> setDep (fun _ -> "b"))>(React.string dep)</button>
      <Effects name="child" dep="x" />
      <Effects name="parent" dep />
    </div>
end

let theme = React.createContext "light"

module Theme_provider = struct
  let make = React.Context.provider theme

  external makeProps :
    value:string -> children:React.element -> unit -> < value : string ; children : React.element > Js.t
    = ""
  [@@mel.obj]
end

module Leaf = struct
  let[@react.component] make () =
    let value = React.useContext theme in
    log ("render leaf " ^ value);
    <em>(React.string value)</em>
end

module Middle = struct
  let[@react.component] make = React.memo (fun () ->
    log "render middle";
    <Leaf />)
end

module Themed = struct
  let[@react.component] make () =
    let value, setValue = React.useState (fun () -> "dark") in
    <section>
      <button onClick=(fun _ -> setValue (fun _ -> "blue"))>(React.string "switch")</button>
      <Theme_provider value><Middle /></Theme_provider>
    </section>
end

module Focus = struct
  let[@react.component] make () =
    let input = React.useRef Js.Nullable.null in
    React.useEffect0 (fun () ->
      Option.iter (fun element -> log ("ref " ^ tag_name element)) (Js.Nullable.toOption input.current);
      None);
    <input ref=(ReactDOM.Ref.domRef input) />
end

module Fancy_input = struct
  let[@react.component] make = React.forwardRef (fun ~label ref ->
    let ref = Option.map ReactDOM.Ref.domRef (Js.Nullable.toOption ref) in
    <input placeholder=label ?ref />)
end

module Forward = struct
  let[@react.component] make () =
    let input = React.useRef Js.Nullable.null in
    React.useEffect0 (fun () ->
      Option.iter
        (fun element -> log ("forwarded " ^ tag_name element ^ " " ^ get_attribute element "placeholder"))
        (Js.Nullable.toOption input.current);
      None);
    <Fancy_input label="name" ref=(ReactDOM.Ref.domRef input) />
end

module Icon = struct
  let[@react.component] make ~d = <path d />
end

module Rows = struct
  let[@react.component] make ~labels =
    <div>(React.array (Array.map (fun label -> <Counter key=label label />) labels))</div>
end

module Created_rows = struct
  let[@react.component] make ~labels =
    <div>
      (React.array
         (Array.map (fun label -> React.createElement Counter.make (Counter.makeProps ~key:label ~label ())) labels))
    </div>
end

module Address = struct
  let[@react.component] make () =
    let url = ReasonReactRouter.useUrl () in
    <p>(React.string (String.concat "/" url.path ^ "#" ^ url.hash ^ "?" ^ url.search))</p>
end

module Toggle = struct
  let[@react.component] make () =
    let shown, setShown = React.useState (fun () -> false) in
    <p>
      (React.string "<")
      (if shown then <b>(React.string "on")</b> else React.null)
      (React.string ">")
      <button onClick=(fun _ -> setShown (fun shown -> not shown))>(React.string "toggle")</button>
    </p>
end

external typed : 'event -> string = "value" [@@mel.get] [@@mel.scope "target"]

(** A row of the marked list. *)
type entry = { id : int; title : string }

(** A list whose rows read the chosen row and a suffix from outside. *)
type marked = { entries : entry array; chosen : int option; suffix : string }

(** What changes the marked list. *)
type mark = Choose of int option | Suffix of string | Drop of int | Grow

let marked_send = ref (fun (_ : mark) -> ())

let mark marked message =
  match message with
  | Choose chosen -> { marked with chosen }
  | Suffix suffix -> { marked with suffix }
  | Drop id -> { marked with entries = Js.Array.filter ~f:(fun entry -> entry.id <> id) marked.entries }
  | Grow ->
      let id = Array.fold_left (fun top entry -> max top (entry.id + 1)) 100 marked.entries in
      { marked with entries = Array.append marked.entries [| { id; title = "t" ^ string_of_int id } |] }

let marked_start = { entries = Array.init 5 (fun id -> { id; title = "t" ^ string_of_int id }); chosen = None; suffix = "" }

module Marked = struct
  let[@react.component] make () =
    let state, send = React.useReducer mark marked_start in
    marked_send := send;
    <ul>
      (React.array
         (Array.map
            (fun entry ->
              <li
                key=(string_of_int entry.id)
                className=(match state.chosen with Some id when id = entry.id -> "on" | Some _ | None -> "")>
                (React.string (entry.title ^ state.suffix))
              </li>)
            state.entries))
    </ul>
end

let marked_html marked =
  "<ul>"
  ^ String.concat ""
      (Array.to_list
         (Array.map
            (fun entry ->
              "<li class=\""
              ^ (match marked.chosen with Some id when id = entry.id -> "on" | Some _ | None -> "")
              ^ "\">" ^ entry.title ^ marked.suffix ^ "</li>")
            marked.entries))
  ^ "</ul>"

module Served = struct
  let[@react.component] make ~start =
    let count, setCount = React.useState (fun () -> start) in
    <section>
      <button onClick=(fun _ -> setCount (fun n -> n + 1))>(React.int count)</button>
      <ul>
        (React.array
           (Array.map
              (fun label -> <li key=label>(React.string label)</li>)
              (Array.init count (fun index -> "r" ^ string_of_int index))))
      </ul>
    </section>
end

external set_inner_html : Dom.element -> string -> unit = "innerHTML" [@@mel.set]
external document_prototype : prototype = "prototype" [@@mel.scope "Document"]

let served count =
  "<section><button>" ^ string_of_int count ^ "</button><ul>"
  ^ String.concat "" (List.init count (fun index -> "<li>r" ^ string_of_int index ^ "</li>"))
  ^ "</ul></section>"

let digits text =
  String.of_seq (Seq.filter (fun letter -> letter >= '0' && letter <= '9') (String.to_seq text))

module Controlled = struct
  let[@react.component] make () =
    let text, setText = React.useState (fun () -> "") in
    let on, setOn = React.useState (fun () -> false) in
    <div>
      <input
        value=text
        onChange=(fun event ->
          setText (fun _ -> digits (typed event))) />
      <input type_="checkbox" checked=on onChange=(fun _ -> setOn (fun on -> on)) />
    </div>
end

external bubbling : string -> < bubbles : bool > Js.t -> Dom.event = "Event" [@@mel.new]
external checked : Dom.element -> bool = "checked" [@@mel.get]
external value_of : Dom.element -> string = "value" [@@mel.get]

let type_into : Dom.element -> string -> unit =
  [%mel.raw
    {|function (element, text) {
        Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value").set.call(element, text);
      }|}]

let later : unit -> unit Js.Promise.t =
  [%mel.raw {|function () { return new Promise((resolve) => setTimeout(resolve, 0)); }|}]

(** What the button's handler does to the event before reading it. *)
type treatment = { prevent : [ `Prevent | `Allow ]; stop : [ `Stop | `Bubble ] }

(** An event sent to the probe, and the element it is sent to. *)
type probe_event =
  | Mouse of { x : int; y : int; button : int; shift : bool; alt : bool; ctrl : bool; meta : bool }
  | Key of { key : string; shift : bool; ctrl : bool; repeat : bool }

let treatment = ref { prevent = `Allow; stop = `Bubble }

let treat ~prevent_default ~stop_propagation =
  (match !treatment.prevent with `Prevent -> prevent_default () | `Allow -> ());
  match !treatment.stop with `Stop -> stop_propagation () | `Bubble -> ()

external tag_of : 'target -> string = "tagName" [@@mel.get]
external current_target_of : Dom.event -> Dom.element Js.null = "currentTarget" [@@mel.get]
external dispatch_kept : Dom.element -> Dom.event -> bool = "dispatchEvent" [@@mel.send]

external mouse_event :
  string ->
  < bubbles : bool ; cancelable : bool ; clientX : int ; clientY : int ; button : int ; shiftKey : bool
  ; altKey : bool ; ctrlKey : bool ; metaKey : bool >
  Js.t ->
  Dom.event = "MouseEvent"
[@@mel.new]

external keyboard_event :
  string ->
  < bubbles : bool ; cancelable : bool ; key : string ; shiftKey : bool ; ctrlKey : bool ; repeat : bool > Js.t ->
  Dom.event = "KeyboardEvent"
[@@mel.new]

let flags values = String.concat "" (List.map (fun value -> match value with true -> "1" | false -> "0") values)

module Probe = struct
  let[@react.component] make () =
    <section
      onClick=(fun event -> log ("section " ^ tag_of (React.Event.Mouse.currentTarget event)))
      onKeyDown=(fun event -> log ("section " ^ tag_of (React.Event.Keyboard.currentTarget event)))>
      <button
        onClick=(fun event ->
          treat
            ~prevent_default:(fun () -> React.Event.Mouse.preventDefault event)
            ~stop_propagation:(fun () -> React.Event.Mouse.stopPropagation event);
          log
            (String.concat " "
               [ React.Event.Mouse.type_ event;
                 tag_of (React.Event.Mouse.currentTarget event);
                 tag_of (React.Event.Mouse.target event);
                 string_of_int (React.Event.Mouse.clientX event);
                 string_of_int (React.Event.Mouse.clientY event);
                 string_of_int (React.Event.Mouse.button event);
                 flags
                   [ React.Event.Mouse.shiftKey event; React.Event.Mouse.altKey event;
                     React.Event.Mouse.ctrlKey event; React.Event.Mouse.metaKey event;
                     React.Event.Mouse.isDefaultPrevented event; React.Event.Mouse.isPropagationStopped event ] ]))
        onKeyDown=(fun event ->
          treat
            ~prevent_default:(fun () -> React.Event.Keyboard.preventDefault event)
            ~stop_propagation:(fun () -> React.Event.Keyboard.stopPropagation event);
          log
            (String.concat " "
               [ React.Event.Keyboard.type_ event;
                 tag_of (React.Event.Keyboard.currentTarget event);
                 tag_of (React.Event.Keyboard.target event);
                 React.Event.Keyboard.key event;
                 flags
                   [ React.Event.Keyboard.shiftKey event; React.Event.Keyboard.ctrlKey event;
                     React.Event.Keyboard.repeat event; React.Event.Keyboard.isDefaultPrevented event;
                     React.Event.Keyboard.isPropagationStopped event ] ]))>
        <b>(React.string "go")</b>
      </button>
    </section>
end

let setters : (string, (int -> int) -> unit) Hashtbl.t = Hashtbl.create 16
let set_labels = ref (fun (_ : string array -> string array) -> ())
let fresh_labels = ref 0

module Tally = struct
  let[@react.component] make = React.memo (fun ~label ->
    let count, setCount = React.useState (fun () -> 0) in
    Hashtbl.replace setters label setCount;
    log ("render " ^ label);
    let doubled =
      React.useMemo1 (fun () -> log ("memo " ^ label); count * 2) [| count |]
    in
    React.useEffect1
      (fun () ->
        log ("effect " ^ label);
        Some (fun () -> log ("cleanup " ^ label)))
      [| count |];
    <li>(React.string (label ^ ":" ^ string_of_int count ^ "/" ^ string_of_int doubled))</li>)
end

module Tallies = struct
  let[@react.component] make () =
    let labels, setLabels = React.useState (fun () -> [||]) in
    set_labels := setLabels;
    <ul>(React.array (Array.map (fun label -> <Tally key=label label />) labels))</ul>
end

(** What a step of the state machine may log. *)
type logged =
  | Exactly of string list
  | At_most_one_call of string  (** React may call a bailed-out component once, without committing. *)

let machine values =
  let tape = tape values in
  let root = attached () in
  let client = ReactDOM.Client.createRoot root in
  let model = ref [||] in
  let shown () =
    Array.to_list
      (Array.map
         (fun (label, count) -> label ^ ":" ^ string_of_int count ^ "/" ^ string_of_int (count * 2))
         !model)
  in
  let click label = Hashtbl.find setters label (fun count -> count + 1) in
  let increment label =
    model := Array.map (fun (other, count) -> if String.equal other label then (other, count + 1) else (other, count)) !model
  in
  let rec step remaining =
    if remaining = 0 then act (fun () -> ReactDOM.Client.unmount client ())
    else begin
      let labels = Array.map fst !model in
      let size = Array.length labels in
      let action, expected =
        match (draw tape 6, size) with
        | 0, _ | _, 0 ->
            incr fresh_labels;
            let label = "t" ^ string_of_int !fresh_labels in
            let at = draw tape (size + 1) in
            model := Array.concat [ Array.sub !model 0 at; [| (label, 0) |]; Array.sub !model at (size - at) ];
            let next = Array.map fst !model in
            ( (fun () -> !set_labels (fun _ -> next)),
              Exactly [ "render " ^ label; "memo " ^ label; "effect " ^ label ] )
        | 1, _ ->
            let at = draw tape size in
            let label = labels.(at) in
            model := Array.of_list (List.filteri (fun index _ -> index <> at) (Array.to_list !model));
            let next = Array.map fst !model in
            ((fun () -> !set_labels (fun _ -> next)), Exactly [ "cleanup " ^ label ])
        | 2, _ ->
            let ranked = Array.map (fun entry -> (draw tape 1000, entry)) !model in
            Array.stable_sort compare ranked;
            model := Array.map snd ranked;
            let next = Array.map fst !model in
            ((fun () -> !set_labels (fun _ -> next)), Exactly [])
        | 3, _ ->
            let label = labels.(draw tape size) in
            increment label;
            ( (fun () -> click label),
              Exactly [ "render " ^ label; "memo " ^ label; "cleanup " ^ label; "effect " ^ label ] )
        | 4, _ ->
            let label = labels.(draw tape size) in
            ((fun () -> Hashtbl.find setters label (fun count -> count)), At_most_one_call label)
        | _, 1 ->
            let label = labels.(0) in
            increment label;
            increment label;
            ( (fun () -> click label; click label),
              Exactly [ "render " ^ label; "memo " ^ label; "cleanup " ^ label; "effect " ^ label ] )
        | _, _ ->
            let first = draw tape size in
            let second = (first + 1 + draw tape (size - 1)) mod size in
            let a = labels.(min first second) and b = labels.(max first second) in
            increment a;
            increment b;
            ( (fun () -> click b; click a),
              Exactly
                [
                  "render " ^ a; "memo " ^ a; "render " ^ b; "memo " ^ b; "cleanup " ^ a; "cleanup " ^ b;
                  "effect " ^ a; "effect " ^ b;
                ] )
      in
      ignore (take ());
      let* () = act action in
      let items = Array.to_list (Array.map (fun node -> text_content node) (nodes (child_nodes (select root "ul")))) in
      let logged = take () in
      expect items |. to_equal (shown ());
      (match expected with
      | Exactly events -> expect logged |. to_equal events
      | At_most_one_call label ->
          expect (List.mem logged [ []; [ "render " ^ label ] ]) |. to_be true);
      step (remaining - 1)
    end
  in
  let* () = act (fun () -> ReactDOM.Client.render client <Tallies />) in
  ignore (take ());
  step 12

let () =
  describe "state machine" (fun () ->
    test_async "every operation sequence matches the model: DOM, renders, memos and effects" (fun () ->
      check_async
        (async_property (tapes ~shortest:30 ~longest:90) machine)
        [%mel.obj { numRuns = 120 }]));
  describe "state" (fun () ->
    test_async "resets the state below a component replaced by another one with the same output" (fun () ->
      let* root, _ = mount <Switch /> in
      let* () = act (fun () -> click (select root "button")) in
      let counted = inner_html root in
      let* () = act (fun () -> click (select root "i")) in
      expect (counted, inner_html root)
      |. to_equal
           ( "<div><section><button>a1</button></section><i>swap</i></div>",
             "<div><section><button>a0</button></section><i>swap</i></div>" );
      finish ());
    test_async "batches updates and re-renders the component" (fun () ->
      let* root, _ = mount <Counter label="n" /> in
      let* () = act (fun () -> click (select root "button"); click (select root "button")) in
      expect (inner_html root, take ()) |. to_equal ("<button>n2</button>", [ "render n" ]);
      finish ());
    test_async "skips memo children whose props are unchanged" (fun () ->
      let* root, _ = mount <Parent /> in
      let* () = act (fun () -> click (select root "button")) in
      expect (take ()) |. to_equal [ "render parent"; "render quiet moved" ];
      finish ()));
  describe "effects" (fun () ->
    test_async "run children first, layout before passive" (fun () ->
      let root = attached () in
      let client = ReactDOM.Client.createRoot root in
      let* () = act (fun () -> ReactDOM.Client.render client <Effect_tree />) in
      expect (take ())
      |. to_equal
           [ "layout child"; "layout parent"; "passive child"; "deps child x"; "passive parent"; "deps parent a" ];
      finish ());
    test_async "clean up before running again when a dependency changes" (fun () ->
      let* root, _ = mount <Effect_tree /> in
      let* () = act (fun () -> click (select root "button")) in
      expect (take ()) |. to_equal [ "deps cleanup parent a"; "deps parent b" ];
      finish ());
    test_async "clean up everything on unmount" (fun () ->
      let* _, client = mount <Effect_tree /> in
      let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
      expect (List.sort compare (take ()))
      |. to_equal
           [
             "deps cleanup child x"; "deps cleanup parent a"; "layout cleanup child"; "layout cleanup parent";
             "passive cleanup child"; "passive cleanup parent";
           ];
      finish ()));
  describe "context" (fun () ->
    test_async "reaches consumers below memo components" (fun () ->
      let* root, _ = mount <Themed /> in
      let* () = act (fun () -> click (select root "button")) in
      expect (inner_html (select root "em"), take ()) |. to_equal ("blue", [ "render leaf blue" ]);
      finish ()));
  describe "refs" (fun () ->
    test_async "point at the element before effects run" (fun () ->
      let root = attached () in
      let client = ReactDOM.Client.createRoot root in
      let* () = act (fun () -> ReactDOM.Client.render client <Focus />) in
      expect (take ()) |. to_equal [ "ref INPUT" ];
      finish ()));
  describe "forwardRef and svg" (fun () ->
    test_async "forward a ref to an element inside the component" (fun () ->
      let root = attached () in
      let client = ReactDOM.Client.createRoot root in
      let* () = act (fun () -> ReactDOM.Client.render client <Forward />) in
      expect (take ()) |. to_equal [ "forwarded INPUT name" ];
      finish ());
    test_async "create a component's svg root in the svg namespace" (fun () ->
      let* root, _ = mount <svg><Icon d="M0 0L9 9" /></svg> in
      expect (namespace_uri (select root "path"), inner_html root)
      |. to_equal ("http://www.w3.org/2000/svg", "<svg><path d=\"M0 0L9 9\"></path></svg>");
      finish ()));
  describe "rows reading outer state" (fun () ->
    test_async "show the chosen row and the suffix after any actions" (fun () ->
      check_async
        (async_property (tapes ~shortest:4 ~longest:40) (fun values ->
             let tape = tape values in
             let* root, client = mount <Marked /> in
             let rec step remaining marked =
               match remaining with
               | 0 ->
                   let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
                   finish ()
               | _ ->
                   let ids = Array.map (fun entry -> entry.id) marked.entries in
                   let pick () =
                     match Array.length ids with 0 -> None | count -> Some ids.(draw tape count)
                   in
                   let message =
                     match draw tape 4 with
                     | 0 -> Choose (match draw tape 3 with 0 -> None | _ -> pick ())
                     | 1 -> Suffix [| ""; "!"; "?" |].(draw tape 3)
                     | 2 -> Option.fold ~none:Grow ~some:(fun id -> Drop id) (pick ())
                     | _ -> Grow
                   in
                   let marked = mark marked message in
                   let* () = act (fun () -> !marked_send message) in
                   expect (inner_html root) |. to_equal (marked_html marked);
                   step (remaining - 1) marked
             in
             step 10 marked_start))
        [%mel.obj { numRuns = 60 }]));
  describe "server rendering" (fun () ->
    test_async "hydrating the server's HTML creates no element and then updates like a render" (fun () ->
      check_async
        (async_property (tapes ~shortest:2 ~longest:8) (fun values ->
             let tape = tape values in
             let start = draw tape 4 and clicks = draw tape 4 in
             let root = attached () in
             set_inner_html root (ReactDOMServer.renderToString <Served start />);
             let creates = spy_on document_prototype "createElement" in
             let client = ref None in
             let* () = act (fun () -> client := Some (ReactDOM.Client.hydrateRoot root <Served start />)) in
             let created = Array.length (calls (mock creates)) in
             restore creates;
             let hydrated = inner_html root in
             let rec click remaining shown =
               match remaining with
               | 0 -> Js.Promise.resolve (List.rev shown)
               | _ ->
                   let* () = act (fun () -> Testing.click (select root "button")) in
                   click (remaining - 1) (inner_html root :: shown)
             in
             let* shown = click clicks [] in
             let* () = act (fun () -> Option.iter (fun client -> ReactDOM.Client.unmount client ()) !client) in
             expect (created, hydrated, shown)
             |. to_equal (0, served start, List.init clicks (fun index -> served (start + index + 1)));
             finish ()))
        [%mel.obj { numRuns = 40 }]));
  describe "forms" (fun () ->
    test_async "a controlled input and checkbox show the state after any input, kept or rejected"
      (fun () ->
        check_async
          (async_property (tapes ~shortest:2 ~longest:16) (fun values ->
               let tape = tape values in
               let words = [| "12"; "a"; "3b4"; ""; "x9" |] in
               let actions =
                 List.init 8 (fun _ ->
                     let word = words.(draw tape (Array.length words)) in
                     match draw tape 2 with 0 -> `Type word | _ -> `Click)
               in
               let _, wanted =
                 List.fold_left_map
                   (fun shown action ->
                     let shown = match action with `Type word -> digits word | `Click -> shown in
                     (shown, (shown, false)))
                   "" actions
               in
               let* root, client = mount <Controlled /> in
               let field = select root "input" and box = select root "input[type=checkbox]" in
               let rec step remaining shown =
                 match remaining with
                 | [] ->
                     let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
                     Js.Promise.resolve (List.rev shown)
                 | action :: rest ->
                     let* () =
                       act (fun () ->
                           match action with
                           | `Type word ->
                               type_into field word;
                               dispatch field (bubbling "input" [%mel.obj { bubbles = true }])
                           | `Click -> click box)
                     in
                     let* () = later () in
                     step rest ((value_of field, checked box) :: shown)
               in
               let* shown = step actions [] in
               expect shown |. to_equal wanted;
               finish ()))
          [%mel.obj { numRuns = 60 }]));
  describe "router" (fun () ->
    test_async "useUrl shows every URL pushed or replaced, parsed as reason-react parses it" (fun () ->
      let addresses =
        [|
          ("/", "#?");
          ("/a/b", "a/b#?");
          ("/a/b/", "a/b#?");
          ("/books#title", "books#title?");
          ("/c?q=2#h", "c#h?q=2");
          ("/x//y", "x/y#?");
          ("/d/?r=1", "d#?r=1");
        |]
      in
      check_async
        (async_property (tapes ~shortest:2 ~longest:30) (fun values ->
             let tape = tape values in
             let steps =
               List.init (1 + draw tape 6) (fun _ ->
                   (addresses.(draw tape (Array.length addresses)), match draw tape 2 with 0 -> `Push | _ -> `Replace))
             in
             ReasonReactRouter.replace "/";
             let adds = spy_on window_object "addEventListener" in
             let removes = spy_on window_object "removeEventListener" in
             let* root, client = mount <Address /> in
             let rec run remaining seen =
               match remaining with
               | [] -> Js.Promise.resolve (List.rev seen)
               | ((address, _), change) :: rest ->
                   let* () =
                     act (fun () ->
                         match change with
                         | `Push -> ReasonReactRouter.push address
                         | `Replace -> ReasonReactRouter.replace address)
                   in
                   run rest (inner_html root :: seen)
             in
             let* seen = run steps [] in
             let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
             let popstate spy =
               List.length (List.filter (fun call -> String.equal call.(0) "popstate") (Array.to_list (calls (mock spy))))
             in
             let left = popstate adds - popstate removes in
             restore adds;
             restore removes;
             let requested = List.filter (fun ((address, _), _) -> not (String.contains address '#')) steps in
             let served =
               List.map
                 (fun ((address, _), _) ->
                   let url = ReasonReactRouter.dangerouslyGetInitialUrl ~serverUrlString:address () in
                   String.concat "/" url.path ^ "?" ^ url.search)
                 requested
             in
             let parsed =
               List.map
                 (fun ((_, shown), _) ->
                   match String.split_on_char '#' shown with
                   | [ path; rest ] -> path ^ "?" ^ List.nth (String.split_on_char '?' rest) 1
                   | _ -> shown)
                 requested
             in
             expect (seen, left, served)
             |. to_equal (List.map (fun ((_, shown), _) -> "<p>" ^ shown ^ "</p>") steps, 0, parsed);
             finish ()))
        [%mel.obj { numRuns = 60 }]));
  describe "events" (fun () ->
    test_async "React.Event reads what was sent, and prevent and stop act as in React" (fun () ->
      check_async
        (async_property (tapes ~shortest:4 ~longest:60) (fun values ->
             let tape = tape values in
             let keys = [| "a"; "Enter"; "Escape"; "ArrowLeft"; " " |] in
             let sent =
               List.init (1 + draw tape 6) (fun _ ->
                   let bit () = draw tape 2 = 1 in
                   let event =
                     match draw tape 2 with
                     | 0 ->
                         Mouse
                           { x = draw tape 500; y = draw tape 500; button = draw tape 2; shift = bit (); alt = bit ();
                             ctrl = bit (); meta = bit () }
                     | _ -> Key { key = keys.(draw tape (Array.length keys)); shift = bit (); ctrl = bit (); repeat = bit () }
                   in
                   let inner = match draw tape 2 with 0 -> "button" | _ -> "b" in
                   let treatment =
                     { prevent = (match draw tape 2 with 0 -> `Prevent | _ -> `Allow);
                       stop = (match draw tape 2 with 0 -> `Stop | _ -> `Bubble) }
                   in
                   (event, inner, treatment))
             in
             let expected =
               List.concat_map
                 (fun (event, inner, treatment) ->
                   let prevented = match treatment.prevent with `Prevent -> true | `Allow -> false in
                   let stopped = match treatment.stop with `Stop -> true | `Bubble -> false in
                   let reading =
                     match event with
                     | Mouse { x; y; button; shift; alt; ctrl; meta } ->
                         String.concat " "
                           [ "click"; "BUTTON"; String.uppercase_ascii inner; string_of_int x; string_of_int y;
                             string_of_int button; flags [ shift; alt; ctrl; meta; prevented; stopped ] ]
                     | Key { key; shift; ctrl; repeat } ->
                         String.concat " "
                           [ "keydown"; "BUTTON"; String.uppercase_ascii inner; key;
                             flags [ shift; ctrl; repeat; prevented; stopped ] ]
                   in
                   let bubbled = match treatment.stop with `Stop -> [] | `Bubble -> [ "section SECTION" ] in
                   (reading :: bubbled) @ [ "kept " ^ flags [ not prevented ]; "released 1" ])
                 sent
             in
             let* root, client = mount <Probe /> in
             let* () =
               act (fun () ->
                   List.iter
                     (fun (event, inner, chosen) ->
                       treatment := chosen;
                       let native =
                         match event with
                         | Mouse { x; y; button; shift; alt; ctrl; meta } ->
                             mouse_event "click"
                               [%mel.obj
                                 { bubbles = true; cancelable = true; clientX = x; clientY = y; button; shiftKey = shift;
                                   altKey = alt; ctrlKey = ctrl; metaKey = meta }]
                         | Key { key; shift; ctrl; repeat } ->
                             keyboard_event "keydown"
                               [%mel.obj { bubbles = true; cancelable = true; key; shiftKey = shift; ctrlKey = ctrl; repeat }]
                       in
                       let kept = dispatch_kept (select root inner) native in
                       log ("kept " ^ flags [ kept ]);
                       log ("released " ^ flags [ Option.is_none (Js.Null.toOption (current_target_of native)) ]))
                     sent)
             in
             let seen = take () in
             let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
             expect seen |. to_equal expected;
             finish ()))
        [%mel.obj { numRuns = 100 }]));
  describe "lists and conditions" (fun () ->
    test_async "React.createElement with makeProps keeps rows and their state exactly as JSX does" (fun () ->
      check_async
        (async_property (tapes ~shortest:4 ~longest:40) (fun values ->
             let tape = tape values in
             let pool = [| "a"; "b"; "c"; "d"; "e" |] in
             let steps =
               List.init (1 + draw tape 8) (fun _ ->
                   match draw tape 2 with
                   | 0 -> `Show (Array.of_list (List.filter (fun _ -> draw tape 2 = 0) (Array.to_list pool)))
                   | _ -> `Click (draw tape 5))
             in
             let* written, written_client = mount <Rows labels=[| "a"; "b"; "c" |] /> in
             let* created, created_client = mount <Created_rows labels=[| "a"; "b"; "c" |] /> in
             let rec run remaining seen =
               match remaining with
               | [] -> Js.Promise.resolve (List.rev seen)
               | step :: rest ->
                   let* () =
                     act (fun () ->
                         match step with
                         | `Show labels ->
                             ReactDOM.Client.render written_client <Rows labels />;
                             ReactDOM.Client.render created_client <Created_rows labels />
                         | `Click index ->
                             List.iter
                               (fun root ->
                                 let buttons = nodes (select_all root "button") in
                                 Option.iter click
                                   (match Array.length buttons with
                                   | 0 -> None
                                   | count -> Some (element_of buttons.(index mod count))))
                               [ written; created ])
                   in
                   run rest ((inner_html written, inner_html created) :: seen)
             in
             let* seen = run steps [] in
             let* () =
               act (fun () ->
                   ReactDOM.Client.unmount written_client ();
                   ReactDOM.Client.unmount created_client ())
             in
             ignore (take ());
             expect (List.map snd seen) |. to_equal (List.map fst seen);
             finish ()))
        [%mel.obj { numRuns = 60 }]);
    test_async "keep component state with its key" (fun () ->
      let* root, client = mount <Rows labels=[| "a"; "b"; "c" |] /> in
      let* () = act (fun () -> click (select root "button")) in
      let* () = act (fun () -> ReactDOM.Client.render client <Rows labels=[| "c"; "a"; "d" |] />) in
      expect (inner_html root)
      |. to_equal "<div><button>c0</button><button>a1</button><button>d0</button></div>";
      finish ());
    test_async "show and hide content between siblings" (fun () ->
      let* root, _ = mount <Toggle /> in
      let* () = act (fun () -> click (select root "button")) in
      let shown = inner_html root in
      let* () = act (fun () -> click (select root "button")) in
      expect (shown, inner_html root)
      |. to_equal
           ( "<p>&lt;<b>on</b>&gt;<button>toggle</button></p>",
             "<p>&lt;&gt;<button>toggle</button></p>" );
      finish ()))
