let bordered (inner : 'props React.component) : 'props React.component =
 fun props -> <div className="border">(React.createElement inner props)</div>

module Bordered_counter = struct
  let make = bordered Counter.make
  let makeProps ~label ?key () = Counter.makeProps ~label ?key ()
end

module Shout = struct
  external makeProps : text:string -> ?key:string -> unit -> < text : string > Js.t = "" [@@mel.obj]

  let make props = <b>(React.string (String.uppercase_ascii props##text))</b>
end

let remembered = React.memo Counter.make

module Typed = struct
  let[@react.component] make ~label ~text =
    <section>
      <Bordered_counter label />
      <Shout text />
      (React.createElement remembered (Counter.makeProps ~label ()))
      (React.createElement (React.component (fun () -> <i>(React.string text)</i>)) ())
    </section>
end

let store = ref 0
let listeners = ref []

let publish value =
  store := value;
  List.iter (fun listener -> listener ()) !listeners

module Fresh_hooks = struct
  let[@react.component] make ~a ~b ~c ~d =
    React.useInsertionEffect4 (fun () -> log ("insert " ^ a ^ b ^ c ^ d); None) (a, b, c, d);
    React.useInsertionEffect7 (fun () -> log ("seven " ^ a ^ d); None) (a, 1, 2, 3, 4, 5, d);
    let shared =
      React.useSyncExternalStoreWithServer
        ~subscribe:(fun listener ->
          listeners := listener :: !listeners;
          fun () -> listeners := List.filter (fun other -> other != listener) !listeners)
        ~getSnapshot:(fun () -> !store)
        ~getServerSnapshot:(fun () -> -1)
    in
    let deferred = React.useDeferredValue (a ^ b) ~initialValue:"" in
    let pending, _ = React.useTransitionAsync () in
    <p>
      (React.string (deferred ^ "/" ^ string_of_int shared ^ "/" ^ string_of_bool pending))
      <button onClick=(fun _ -> publish (!store + 1))>(React.string "go")</button>
    </p>
end

module Probe_utils = struct
  let[@react.component] make () =
    let count, setCount = React.useState (fun () -> 0) in
    let text, setText = React.useState (fun () -> "") in
    let ticked, setTicked = React.useState (fun () -> false) in
    <div>
      <button onClick=(fun _ -> setCount (fun count -> count + 1))>(React.int count)</button>
      <input
        className="text"
        value=text
        onChange=(fun event ->
          let value = (React.Event.Form.target event)##value in
          setText (fun _ -> String.sub value 0 (min 3 (String.length value))))
        onFocus=(fun _ -> log "focus")
        onBlur=(fun _ -> log "blur")
      />
      <input
        className="tick"
        type_="checkbox"
        checked=ticked
        onChange=(fun event ->
          let checked = (React.Event.Form.target event)##checked in
          setTicked (fun _ -> checked))
      />
      <p>(React.string (text ^ "|" ^ string_of_bool ticked))</p>
    </div>
end

external npmCreateElement : string -> < .. > Js.t -> React.element = "createElement" [@@mel.module "react"]

external npmCreateElementWith : string -> < .. > Js.t -> React.element array -> React.element = "createElement"
[@@mel.module "react"] [@@mel.variadic]

external npmCreateElementOne : string -> < .. > Js.t -> React.element -> React.element = "createElement"
[@@mel.module "react"]

external npmCreateAny : 'kind -> 'props -> React.element array -> React.element = "createElement"
[@@mel.module "react"] [@@mel.variadic]

external npmJsx : string -> < .. > Js.t -> React.element = "jsx" [@@mel.module "react/jsx-runtime"]
external npmJsxs : string -> < .. > Js.t -> React.element = "jsxs" [@@mel.module "react/jsx-runtime"]

external npmJsxKeyed : string -> < .. > Js.t -> ?key:string -> unit -> React.element = "jsx"
[@@mel.module "react/jsx-runtime"]

external npmFragment : < children : React.element > Js.t React.component = "Fragment" [@@mel.module "react"]

module Npm_elements = struct
  let[@react.component] make ~label =
    let count, setCount = React.useState (fun () -> 0) in
    npmCreateElementWith "section" [%mel.obj { className = "npm" }]
      [|
        npmCreateElement "h1" [%mel.obj { id = "x"; children = React.string label }];
        npmCreateElementOne "button" [%mel.obj { onClick = (fun _ -> setCount (fun count -> count + 1)) }] (React.int count);
        npmJsx "em" [%mel.obj { children = React.string "jsx" }];
        npmJsxs "ul"
          [%mel.obj
            {
              children =
                Array.map
                  (fun item -> npmJsxKeyed "li" [%mel.obj { children = React.string item }] ~key:item ())
                  [| label; "z" |];
            }];
        npmCreateAny npmFragment [%mel.obj { children = React.string "frag" }] [||];
        npmCreateAny Shout.make (Shout.makeProps ~text:label ()) [||];
      |]
end

