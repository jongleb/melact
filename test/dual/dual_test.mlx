(** A random page, rendered both by the build under test and by React itself. *)
type shape =
  | Pair of string * string
  | Mixed of string * int * shape
  | Listed of string list
  | Maybe of shape option
  | Shown of int
  | Twin of shape * shape

module Shown = struct
  let[@react.component] make ~count = <i>(React.int count)</i>
end

let rec page shape =
  match shape with
  | Pair (first, second) -> <p>(React.string first)(React.string second)</p>
  | Mixed (label, count, inner) ->
      <div className=label>
        (React.string "static ")(React.string "too ")(React.string label)<b>(React.int count)</b>(page inner)
      </div>
  | Listed labels -> <ul>(React.array (Array.of_list (List.map (fun label -> <li key=label>(React.string label)</li>) labels)))</ul>
  | Maybe inner -> <section>(Option.fold ~none:React.null ~some:page inner)</section>
  | Shown count -> <Shown count />
  | Twin (first, second) -> <div>(page first)(page second)</div>

(** An element of npm React, built without JSX. *)
type real

external h : string -> 'props Js.Nullable.t -> real array -> real = "createElement" [@@mel.module "react"] [@@mel.variadic]
external real_text : string -> real = "%identity"
external real_null : real = "null"
external render_real : real -> string = "renderToString" [@@mel.module "react-dom/server"]

let rec real shape =
  match shape with
  | Pair (first, second) -> h "p" Js.Nullable.null [| real_text first; real_text second |]
  | Mixed (label, count, inner) ->
      h "div"
        (Js.Nullable.return [%mel.obj { className = label }])
        [| real_text "static "; real_text "too "; real_text label; h "b" Js.Nullable.null [| real_text (string_of_int count) |]; real inner |]
  | Listed labels ->
      h "ul" Js.Nullable.null
        (Array.of_list (List.map (fun label -> h "li" (Js.Nullable.return [%mel.obj { key = label }]) [| real_text label |]) labels))
  | Maybe inner -> h "section" Js.Nullable.null [| Option.fold ~none:real_null ~some:real inner |]
  | Shown count -> h "i" Js.Nullable.null [| real_text (string_of_int count) |]
  | Twin (first, second) -> h "div" Js.Nullable.null [| real first; real second |]

let words = [| ""; "a"; "b"; "ab" |]

let rec shaped tape depth =
  match draw tape (match depth with 0 -> 2 | _ -> 6) with
  | 0 -> Pair (words.(draw tape 4), words.(draw tape 4))
  | 1 -> Shown (draw tape 10)
  | 2 -> Mixed (words.(draw tape 4), draw tape 10, shaped tape (depth - 1))
  | 3 -> Listed (List.sort_uniq String.compare (List.init (draw tape 4) (fun _ -> words.(1 + draw tape 3))))
  | 4 -> Maybe (match draw tape 2 with 0 -> None | _ -> Some (shaped tape (depth - 1)))
  | _ -> Twin (shaped tape (depth - 1), shaped tape (depth - 1))

let rec alter tape shape =
  match (draw tape 2, shape) with
  | 0, _ -> shaped tape 2
  | _, Pair _ -> Pair (words.(draw tape 4), words.(draw tape 4))
  | _, Shown _ -> Shown (draw tape 10)
  | _, Mixed (_, _, inner) -> Mixed (words.(draw tape 4), draw tape 10, alter tape inner)
  | _, Listed _ -> Listed (List.sort_uniq String.compare (List.init (draw tape 4) (fun _ -> words.(1 + draw tape 3))))
  | _, Maybe inner -> Maybe (match draw tape 3 with 0 -> None | _ -> Option.map (alter tape) inner)
  | _, Twin (first, second) -> Twin (alter tape first, alter tape second)

module Toggle = struct
  let[@react.component] make () =
    let shown, setShown = React.useState (fun () -> false) in
    <p>
      (React.string "<")
      (if shown then <b>(React.string "on")</b> else React.null)
      (React.string ">")
      <button onClick=(fun _ -> setShown (fun shown -> not shown))>(React.string "toggle")</button>
    </p>
end

external typed : 'event -> string = "value" [@@mel.get] [@@mel.scope "target"]

(** A row of the marked list. *)
type entry = { id : int; title : string }

(** A list whose rows read the chosen row and a suffix from outside. *)
type marked = { entries : entry array; chosen : int option; suffix : string }

(** What changes the marked list. *)
type mark = Choose of int option | Suffix of string | Drop of int | Grow

let marked_send = ref (fun (_ : mark) -> ())

let mark marked message =
  match message with
  | Choose chosen -> { marked with chosen }
  | Suffix suffix -> { marked with suffix }
  | Drop id -> { marked with entries = Js.Array.filter ~f:(fun entry -> entry.id <> id) marked.entries }
  | Grow ->
      let id = Array.fold_left (fun top entry -> max top (entry.id + 1)) 100 marked.entries in
      { marked with entries = Array.append marked.entries [| { id; title = "t" ^ string_of_int id } |] }

let marked_start = { entries = Array.init 5 (fun id -> { id; title = "t" ^ string_of_int id }); chosen = None; suffix = "" }

module Marked = struct
  let[@react.component] make () =
    let state, send = React.useReducer mark marked_start in
    marked_send := send;
    <ul>
      (React.array
         (Array.map
            (fun entry ->
              <li
                key=(string_of_int entry.id)
                className=(match state.chosen with Some id when id = entry.id -> "on" | Some _ | None -> "")>
                (React.string (entry.title ^ state.suffix))
              </li>)
            state.entries))
    </ul>
end

let marked_html marked =
  "<ul>"
  ^ String.concat ""
      (Array.to_list
         (Array.map
            (fun entry ->
              "<li class=\""
              ^ (match marked.chosen with Some id when id = entry.id -> "on" | Some _ | None -> "")
              ^ "\">" ^ entry.title ^ marked.suffix ^ "</li>")
            marked.entries))
  ^ "</ul>"

(** A way reason-react code writes a keyed list. *)
type form =
  | Mapped
  | Last_piped
  | Belt_piped
  | Js_labelled
  | Indexed
  | Index_unused
  | Belt_indexed
  | Js_indexed

let forms =
  [| Mapped; Last_piped; Belt_piped; Js_labelled; Indexed; Index_unused; Belt_indexed; Js_indexed |]

(** The labels a list shows and the suffix every row reads. *)
type listing = { labels : string array; suffix : string }

let listing_send = ref (fun (_ : listing -> listing) -> ())

module Entry = struct
  let[@react.component] make ~text ~onPick = <li onClick=(fun _ -> onPick ())>(React.string text)</li>
end

module Forms = struct
  let[@react.component] make ~form =
    let listing, setListing = React.useState (fun () -> { labels = [||]; suffix = "" }) in
    listing_send := setListing;
    let { labels; suffix } = listing in
    let pick () = setListing (fun current -> current) in
    match form with
    | Mapped -> <ul>(React.array (Array.map (fun label -> <Entry key=label text=(label ^ suffix) onPick=pick />) labels))</ul>
    | Last_piped -> <ul>(labels |> Array.map (fun label -> <Entry key=label text=(label ^ suffix) onPick=pick />) |> React.array)</ul>
    | Belt_piped -> <ul>(labels |. Belt.Array.map (fun label -> <Entry key=label text=(label ^ suffix) onPick=pick />) |. React.array)</ul>
    | Js_labelled -> <ul>(labels |. Js.Array.map ~f:(fun label -> <Entry key=label text=(label ^ suffix) onPick=pick />) |. React.array)</ul>
    | Indexed ->
        <ul>
          (Array.mapi (fun index label -> <Entry key=label text=(string_of_int index ^ ":" ^ label ^ suffix) onPick=pick />) labels
          |. React.array)
        </ul>
    | Index_unused -> <ul>(Array.mapi (fun _ label -> <Entry key=label text=(label ^ suffix) onPick=pick />) labels |. React.array)</ul>
    | Belt_indexed ->
        <ul>
          (labels
          |. Belt.Array.mapWithIndex (fun index label -> <Entry key=label text=(string_of_int index ^ ":" ^ label ^ suffix) onPick=pick />)
          |. React.array)
        </ul>
    | Js_indexed ->
        <ul>
          (labels
          |. Js.Array.mapi ~f:(fun label index -> <Entry key=label text=(string_of_int index ^ ":" ^ label ^ suffix) onPick=pick />)
          |. React.array)
        </ul>
end

let listing_html form { labels; suffix } =
  let numbered = match form with Indexed | Belt_indexed | Js_indexed -> `Numbered | Mapped | Last_piped | Belt_piped | Js_labelled | Index_unused -> `Plain in
  "<ul>"
  ^ String.concat ""
      (Array.to_list
         (Array.mapi
            (fun index label ->
              "<li>" ^ (match numbered with `Numbered -> string_of_int index ^ ":" | `Plain -> "") ^ label ^ suffix ^ "</li>")
            labels))
  ^ "</ul>"

(** What the parent of the memo law holds: every leaf reads some of it. *)
type tally = { step : int; label : string; total : int }

let tally_start = { step = 1; label = "a"; total = 0 }
let tally_send = ref (fun (_ : tally -> tally) -> ())

module Tally_leaf = struct
  let[@react.component] make ~onPick ~style ~tags ~pair ~children =
    <li className="leaf" style onClick=(fun _ -> onPick ())>
      (React.string (String.concat "," (Array.to_list tags) ^ "|" ^ fst pair ^ string_of_int (snd pair)))
      children
    </li>
end

module Tallied = struct
  let[@react.component] make () =
    let tally, setTally = React.useState (fun () -> tally_start) in
    tally_send := setTally;
    let { step; label; total } = tally in
    <ul>
      <Tally_leaf
        onPick=(fun () -> setTally (fun _ -> { step; label; total = total + step }))
        style=(ReactDOM.Style.make ~color:(match label with "a" -> "red" | _ -> "blue") ())
        tags=[| label; string_of_int step |]
        pair=(label, total)>
        <b>(React.int total)</b>
      </Tally_leaf>
      <Tally_leaf
        onPick=(fun () -> setTally (fun current -> { current with total = current.total + 1 }))
        style=(ReactDOM.Style.make ~color:"green" ())
        tags=[||]
        pair=("", step)>
        <i>(React.string label)</i>
      </Tally_leaf>
    </ul>
end

let tallied_text { step; label; total } =
  label ^ "," ^ string_of_int step ^ "|" ^ label ^ string_of_int total ^ string_of_int total ^ "|" ^ string_of_int step ^ label

let versioned_send = ref (fun (_ : int * int -> int * int) -> ())

module Versioned = struct
  let[@react.component] make ~built =
    let (version, other), setState = React.useState (fun () -> (0, 0)) in
    versioned_send := setState;
    let reference =
      React.useCallback1
        (fun element ->
          log ("v" ^ string_of_int version ^ " " ^ match Js.Nullable.toOption element with Some _ -> "element" | None -> "null"))
        [| version |]
    in
    match built with
    | `Compiled -> <div><p ref=(ReactDOM.Ref.callbackDomRef reference)>(React.int other)</p></div>
    | `At_run_time ->
        <div>
          (ReactDOM.createElement "p" ~props:(ReactDOM.domProps ~ref:(ReactDOM.Ref.callbackDomRef reference) ()) [| React.int other |])
        </div>
end

module Served = struct
  let[@react.component] make ~start =
    let count, setCount = React.useState (fun () -> start) in
    <section>
      <button onClick=(fun _ -> setCount (fun n -> n + 1))>(React.int count)</button>
      <ul>
        (React.array
           (Array.map
              (fun label -> <li key=label>(React.string label)</li>)
              (Array.init count (fun index -> "r" ^ string_of_int index))))
      </ul>
    </section>
end

external set_inner_html : Dom.element -> string -> unit = "innerHTML" [@@mel.set]
external document_prototype : prototype = "prototype" [@@mel.scope "Document"]

let served count =
  "<section><button>" ^ string_of_int count ^ "</button><ul>"
  ^ String.concat "" (List.init count (fun index -> "<li>r" ^ string_of_int index ^ "</li>"))
  ^ "</ul></section>"

let digits text =
  String.of_seq (Seq.filter (fun letter -> letter >= '0' && letter <= '9') (String.to_seq text))

module Controlled = struct
  let[@react.component] make () =
    let text, setText = React.useState (fun () -> "") in
    let on, setOn = React.useState (fun () -> false) in
    <div>
      <input
        value=text
        onChange=(fun event ->
          setText (fun _ -> digits (typed event))) />
      <input type_="checkbox" checked=on onChange=(fun _ -> setOn (fun on -> on)) />
    </div>
end

module Box = struct
  let[@react.component] make ~initial =
    let on, setOn = React.useState (fun () -> initial) in
    <input type_="checkbox" checked=on onChange=(fun _ -> setOn (fun on -> not on)) />
end

module Boxed = struct
  let[@react.component] make ~generation ~initial = <p><Box key=(string_of_int generation) initial /></p>
end

external bubbling : string -> < bubbles : bool > Js.t -> Dom.event = "Event" [@@mel.new]
external checked : Dom.element -> bool = "checked" [@@mel.get]
external has_attribute : Dom.element -> string -> bool = "hasAttribute" [@@mel.send]
external value_of : Dom.element -> string = "value" [@@mel.get]

let type_into : Dom.element -> string -> unit =
  [%mel.raw
    {|function (element, text) {
        Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value").set.call(element, text);
      }|}]

let paused : int -> unit Js.Promise.t =
  [%mel.raw {|function (delay) { return new Promise((resolve) => setTimeout(resolve, delay)); }|}]

(** What the button's handler does to the event before reading it. *)
type treatment = { prevent : [ `Prevent | `Allow ]; stop : [ `Stop | `Bubble ] }

(** An event sent to the probe, and the element it is sent to. *)
type probe_event =
  | Mouse of { x : int; y : int; button : int; shift : bool; alt : bool; ctrl : bool; meta : bool }
  | Key of { key : string; shift : bool; ctrl : bool; repeat : bool }

let treatment = ref { prevent = `Allow; stop = `Bubble }

let treat ~prevent_default ~stop_propagation =
  (match !treatment.prevent with `Prevent -> prevent_default () | `Allow -> ());
  match !treatment.stop with `Stop -> stop_propagation () | `Bubble -> ()

external tag_of : 'target -> string = "tagName" [@@mel.get]
external current_target_of : Dom.event -> Dom.element Js.null = "currentTarget" [@@mel.get]
external dispatch_kept : Dom.element -> Dom.event -> bool = "dispatchEvent" [@@mel.send]

external mouse_event :
  string ->
  < bubbles : bool ; cancelable : bool ; clientX : int ; clientY : int ; button : int ; shiftKey : bool
  ; altKey : bool ; ctrlKey : bool ; metaKey : bool >
  Js.t ->
  Dom.event = "MouseEvent"
[@@mel.new]

external keyboard_event :
  string ->
  < bubbles : bool ; cancelable : bool ; key : string ; shiftKey : bool ; ctrlKey : bool ; repeat : bool > Js.t ->
  Dom.event = "KeyboardEvent"
[@@mel.new]

let flags values = String.concat "" (List.map (fun value -> match value with true -> "1" | false -> "0") values)

module Probe = struct
  let[@react.component] make () =
    <section
      onClick=(fun event -> log ("section " ^ tag_of (React.Event.Mouse.currentTarget event)))
      onKeyDown=(fun event -> log ("section " ^ tag_of (React.Event.Keyboard.currentTarget event)))>
      <button
        onClick=(fun event ->
          treat
            ~prevent_default:(fun () -> React.Event.Mouse.preventDefault event)
            ~stop_propagation:(fun () -> React.Event.Mouse.stopPropagation event);
          log
            (String.concat " "
               [ React.Event.Mouse.type_ event;
                 tag_of (React.Event.Mouse.currentTarget event);
                 tag_of (React.Event.Mouse.target event);
                 string_of_int (React.Event.Mouse.clientX event);
                 string_of_int (React.Event.Mouse.clientY event);
                 string_of_int (React.Event.Mouse.button event);
                 flags
                   [ React.Event.Mouse.shiftKey event; React.Event.Mouse.altKey event;
                     React.Event.Mouse.ctrlKey event; React.Event.Mouse.metaKey event;
                     React.Event.Mouse.isDefaultPrevented event; React.Event.Mouse.isPropagationStopped event ] ]))
        onKeyDown=(fun event ->
          treat
            ~prevent_default:(fun () -> React.Event.Keyboard.preventDefault event)
            ~stop_propagation:(fun () -> React.Event.Keyboard.stopPropagation event);
          log
            (String.concat " "
               [ React.Event.Keyboard.type_ event;
                 tag_of (React.Event.Keyboard.currentTarget event);
                 tag_of (React.Event.Keyboard.target event);
                 React.Event.Keyboard.key event;
                 flags
                   [ React.Event.Keyboard.shiftKey event; React.Event.Keyboard.ctrlKey event;
                     React.Event.Keyboard.repeat event; React.Event.Keyboard.isDefaultPrevented event;
                     React.Event.Keyboard.isPropagationStopped event ] ]))>
        <b>(React.string "go")</b>
      </button>
    </section>
end

let setters : (string, (int -> int) -> unit) Hashtbl.t = Hashtbl.create 16
let set_labels = ref (fun (_ : string array -> string array) -> ())
let fresh_labels = ref 0

module Tally = struct
  let[@react.component] make = React.memo (fun ~label ->
    let count, setCount = React.useState (fun () -> 0) in
    Hashtbl.replace setters label setCount;
    log ("render " ^ label);
    let doubled =
      React.useMemo1 (fun () -> log ("memo " ^ label); count * 2) [| count |]
    in
    React.useEffect1
      (fun () ->
        log ("effect " ^ label);
        Some (fun () -> log ("cleanup " ^ label)))
      [| count |];
    <li>(React.string (label ^ ":" ^ string_of_int count ^ "/" ^ string_of_int doubled))</li>)
end

module Tallies = struct
  let[@react.component] make () =
    let labels, setLabels = React.useState (fun () -> [||]) in
    set_labels := setLabels;
    <ul>(React.array (Array.map (fun label -> <Tally key=label label />) labels))</ul>
end

(** What a step of the state machine may log. *)
type logged =
  | Exactly of string list
  | At_most_one_call of string  (** React may call a bailed-out component once, without committing. *)

let machine values =
  let tape = tape values in
  let root = attached () in
  let client = ReactDOM.Client.createRoot root in
  let model = ref [||] in
  let shown () =
    Array.to_list
      (Array.map
         (fun (label, count) -> label ^ ":" ^ string_of_int count ^ "/" ^ string_of_int (count * 2))
         !model)
  in
  let click label = Hashtbl.find setters label (fun count -> count + 1) in
  let increment label =
    model := Array.map (fun (other, count) -> if String.equal other label then (other, count + 1) else (other, count)) !model
  in
  let rec step remaining =
    if remaining = 0 then act (fun () -> ReactDOM.Client.unmount client ())
    else begin
      let labels = Array.map fst !model in
      let size = Array.length labels in
      let action, expected =
        match (draw tape 6, size) with
        | 0, _ | _, 0 ->
            incr fresh_labels;
            let label = "t" ^ string_of_int !fresh_labels in
            let at = draw tape (size + 1) in
            model := Array.concat [ Array.sub !model 0 at; [| (label, 0) |]; Array.sub !model at (size - at) ];
            let next = Array.map fst !model in
            ( (fun () -> !set_labels (fun _ -> next)),
              Exactly [ "render " ^ label; "memo " ^ label; "effect " ^ label ] )
        | 1, _ ->
            let at = draw tape size in
            let label = labels.(at) in
            model := Array.of_list (List.filteri (fun index _ -> index <> at) (Array.to_list !model));
            let next = Array.map fst !model in
            ((fun () -> !set_labels (fun _ -> next)), Exactly [ "cleanup " ^ label ])
        | 2, _ ->
            let ranked = Array.map (fun entry -> (draw tape 1000, entry)) !model in
            Array.stable_sort compare ranked;
            model := Array.map snd ranked;
            let next = Array.map fst !model in
            ((fun () -> !set_labels (fun _ -> next)), Exactly [])
        | 3, _ ->
            let label = labels.(draw tape size) in
            increment label;
            ( (fun () -> click label),
              Exactly [ "render " ^ label; "memo " ^ label; "cleanup " ^ label; "effect " ^ label ] )
        | 4, _ ->
            let label = labels.(draw tape size) in
            ((fun () -> Hashtbl.find setters label (fun count -> count)), At_most_one_call label)
        | _, 1 ->
            let label = labels.(0) in
            increment label;
            increment label;
            ( (fun () -> click label; click label),
              Exactly [ "render " ^ label; "memo " ^ label; "cleanup " ^ label; "effect " ^ label ] )
        | _, _ ->
            let first = draw tape size in
            let second = (first + 1 + draw tape (size - 1)) mod size in
            let a = labels.(min first second) and b = labels.(max first second) in
            increment a;
            increment b;
            ( (fun () -> click b; click a),
              Exactly
                [
                  "render " ^ a; "memo " ^ a; "render " ^ b; "memo " ^ b; "cleanup " ^ a; "cleanup " ^ b;
                  "effect " ^ a; "effect " ^ b;
                ] )
      in
      ignore (take ());
      let* () = act action in
      let items = Array.to_list (Array.map (fun node -> text_content node) (nodes (child_nodes (select root "ul")))) in
      let logged = take () in
      expect items |. to_equal (shown ());
      (match expected with
      | Exactly events -> expect logged |. to_equal events
      | At_most_one_call label ->
          expect (List.mem logged [ []; [ "render " ^ label ] ]) |. to_be true);
      step (remaining - 1)
    end
  in
  let* () = act (fun () -> ReactDOM.Client.render client <Tallies />) in
  ignore (take ());
  step 12

(** Where a bomb throws once its fuse burns down. *)
type blast =
  | Rendering
  | Marking_up  (** While rendering, from inside its JSX. *)
  | Laying_out
  | Painting

(** What burns a bomb's fuse: its own clicks, or the ticks of the whole field. *)
type fuse = Clicks of int * blast | Ticks of int * blast

(** Whether a boundary's fallback shows the error or throws again. *)
type brittleness =
  | Sturdy
  | Brittle  (** The fallback function throws. *)
  | Trapped  (** The fallback renders a component that throws. *)

(** A field of bombs and error boundaries around them. *)
type mine =
  | Bomb of { name : string; fuse : fuse; arrival : int  (** The tick it is laid at. *) }
  | Guard of { name : string; brittleness : brittleness; mines : mine list }

let bumps : (string, unit -> unit) Hashtbl.t = Hashtbl.create 16
let ticker = ref (fun () -> ())

module Bomb = struct
  let[@react.component] make ~name ~fuse ~tick =
    let count, setCount = React.useState (fun () -> 0) in
    Hashtbl.replace bumps name (fun () -> setCount (fun count -> count + 1));
    let thrown blast () =
      match (fuse, blast) with
      | ( Clicks (at, Rendering), Rendering
        | Clicks (at, Marking_up), Marking_up
        | Clicks (at, Laying_out), Laying_out
        | Clicks (at, Painting), Painting )
        when count >= at ->
          Js.Exn.raiseError name
      | ( Ticks (at, Rendering), Rendering
        | Ticks (at, Marking_up), Marking_up
        | Ticks (at, Laying_out), Laying_out
        | Ticks (at, Painting), Painting )
        when tick >= at ->
          Js.Exn.raiseError name
      | (Clicks _ | Ticks _), _ -> None
    in
    ignore (thrown Rendering ());
    React.useLayoutEffect2 (thrown Laying_out) (count, tick);
    React.useEffect2 (thrown Painting) (count, tick);
    <button>
      (React.string (Option.fold ~none:"" ~some:(fun () -> "") (thrown Marking_up ()) ^ name ^ " " ^ string_of_int count))
    </button>
end

module Dud = struct
  let[@react.component] make ~name =
    let shown, _ = React.useState (fun () -> "fallback " ^ name) in
    Js.Exn.raiseError shown
end

let rec laid ~tick mine =
  match mine with
  | Bomb { name; fuse; _ } -> <Bomb key=name name fuse tick />
  | Guard { name; brittleness; mines } ->
      <ReasonReactErrorBoundary
        key=name
        fallback=(fun ({ error; _ } : Js.Exn.t ReasonReactErrorBoundary.params) ->
          match brittleness with
          | Brittle -> Js.Exn.raiseError ("fallback " ^ name)
          | Trapped -> <Dud name />
          | Sturdy -> <i>(React.string (Option.value ~default:"" (Js.Exn.message error)))</i>)>
        (React.array
           (Array.of_list
              (List.filter_map
                 (fun mine ->
                   match mine with
                   | Bomb { arrival; _ } when arrival > tick -> None
                   | Bomb _ | Guard _ -> Some (laid ~tick mine))
                 mines)))
      </ReasonReactErrorBoundary>

module Minefield = struct
  let[@react.component] make ~mines =
    let tick, setTick = React.useState (fun () -> 0) in
    ticker := (fun () -> setTick (fun tick -> tick + 1));
    <main>(laid ~tick (Guard { name = "g0"; brittleness = Sturdy; mines }))</main>
end

let quiet_errors : unit -> unit -> unit =
  [%mel.raw {|function () { const loud = console.error; console.error = () => {}; return () => { console.error = loud; }; }|}]

let minefield values =
  let tape = tape values in
  let fresh = ref 0 in
  let named prefix = incr fresh; prefix ^ string_of_int !fresh in
  let rec sown depth =
    List.init (draw tape 4) (fun _ ->
        match (depth < 3, draw tape 2) with
        | true, 0 ->
            let name = named "g" in
            let brittleness = match draw tape 4 with 0 -> Brittle | 1 -> Trapped | _ -> Sturdy in
            Guard { name; brittleness; mines = sown (depth + 1) }
        | _, _ ->
            let blast = match draw tape 4 with 0 -> Rendering | 1 -> Marking_up | 2 -> Laying_out | _ -> Painting in
            let fuse =
              match (draw tape 2, blast) with
              | 0, ((Rendering | Marking_up) as blast) -> Ticks (draw tape 4, blast)
              | 0, (Laying_out | Painting) -> Ticks (0, blast)
              | _, ((Rendering | Marking_up) as blast) -> Clicks (draw tape 4, blast)
              | _, (Laying_out | Painting) -> Clicks (1 + draw tape 3, blast)
            in
            let arrival =
              match (fuse, draw tape 3) with
              | Ticks (_, (Laying_out | Painting)), _ | _, (1 | 2) -> 0
              | _, _ -> 1 + draw tape 2
            in
            Bomb { name = named "b"; fuse; arrival })
  in
  let mines = sown 0 in
  let counts = Hashtbl.create 16 and failed = Hashtbl.create 16 and tick = ref 0 in
  let rec blown blast caught nearest mine =
    match mine with
    | Bomb { arrival; _ } when arrival > !tick -> ()
    | Bomb { name; fuse; _ } -> (
        let count = Option.value ~default:0 (Hashtbl.find_opt counts name) in
        match (fuse, blast) with
        | ( Clicks (at, (Rendering | Marking_up)), Rendering
          | Clicks (at, Laying_out), Laying_out
          | Clicks (at, Painting), Painting )
          when count >= at ->
            Hashtbl.replace caught nearest name
        | ( Ticks (at, (Rendering | Marking_up)), Rendering
          | Ticks (at, Laying_out), Laying_out
          | Ticks (at, Painting), Painting )
          when !tick >= at ->
            Hashtbl.replace caught nearest name
        | (Clicks _ | Ticks _), _ -> ())
    | Guard { name; mines; _ } -> (
        match Hashtbl.mem failed name with true -> () | false -> List.iter (blown blast caught name) mines)
  in
  let rec committed caught fallen mine =
    match mine with
    | Bomb _ -> ()
    | Guard { name; mines; _ } -> (
        match (Hashtbl.mem failed name, Hashtbl.find_opt caught name) with
        | true, _ -> ()
        | false, Some error ->
            Hashtbl.replace failed name error;
            Hashtbl.replace fallen name ()
        | false, None -> List.iter (committed caught fallen) mines)
  in
  let rec rendered struck fallen caught nearest mine =
    match mine with
    | Bomb _ -> ()
    | Guard { name; brittleness; mines } -> (
        match (Hashtbl.find_opt struck name, Hashtbl.mem fallen name, Hashtbl.mem failed name, brittleness) with
        | Some error, _, _, _ -> Hashtbl.replace caught name error
        | None, true, _, (Brittle | Trapped) -> Hashtbl.replace caught nearest ("fallback " ^ name)
        | None, true, _, Sturdy | None, false, true, _ -> ()
        | None, false, false, _ -> List.iter (rendered struck fallen caught name) mines)
  in
  let field = Guard { name = "g0"; brittleness = Sturdy; mines } in
  let settled () =
    let rec cycle caught effects =
      let fallen = Hashtbl.create 16 and struck = Hashtbl.create 16 in
      committed caught fallen field;
      (match effects with
      | `Run ->
          blown Laying_out struck "" field;
          blown Painting struck "" field
      | `Done -> ());
      match (Hashtbl.length fallen, Hashtbl.length struck) with
      | 0, 0 -> ()
      | _, _ ->
          let next = Hashtbl.create 16 in
          rendered struck fallen next "" field;
          cycle next `Done
    in
    let caught = Hashtbl.create 16 in
    blown Rendering caught "" field;
    cycle caught `Run
  in
  let rec shown mine =
    match mine with
    | Bomb { arrival; _ } when arrival > !tick -> ""
    | Bomb { name; _ } ->
        "<button>" ^ name ^ " " ^ string_of_int (Option.value ~default:0 (Hashtbl.find_opt counts name)) ^ "</button>"
    | Guard { name; mines; _ } ->
        Option.fold
          ~none:(String.concat "" (List.map shown mines))
          ~some:(fun error -> "<i>" ^ error ^ "</i>")
          (Hashtbl.find_opt failed name)
  in
  let rec live mine =
    match mine with
    | Bomb { arrival; _ } when arrival > !tick -> []
    | Bomb { name; _ } -> [ name ]
    | Guard { name; mines; _ } -> (
        match Hashtbl.mem failed name with true -> [] | false -> List.concat_map live mines)
  in
  let root = attached () in
  let client = ReactDOM.Client.createRoot root in
  let loud = quiet_errors () in
  let rec step remaining seen =
    match remaining with
    | 0 -> Js.Promise.resolve (List.rev seen)
    | _ ->
        let action =
          match (draw tape 3, live field) with
          | 0, _ | _, [] ->
              incr tick;
              fun () -> !ticker ()
          | _, names ->
              let name = List.nth names (draw tape (List.length names)) in
              Hashtbl.replace counts name (1 + Option.value ~default:0 (Hashtbl.find_opt counts name));
              fun () -> Hashtbl.find bumps name ()
        in
        settled ();
        let* () = act action in
        step (remaining - 1) ((inner_html root, "<main>" ^ shown field ^ "</main>") :: seen)
  in
  settled ();
  let* () = act (fun () -> ReactDOM.Client.render client <Minefield mines />) in
  let first = (inner_html root, "<main>" ^ shown field ^ "</main>") in
  let* seen = step 8 [ first ] in
  let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
  loud ();
  expect (Array.of_list (List.map fst seen)) |. to_equal (Array.of_list (List.map snd seen));
  finish ()

let () =
  describe "state machine" (fun () ->
    test_async "every operation sequence matches the model: DOM, renders, memos and effects" (fun () ->
      check_async
        (async_property (tapes ~shortest:30 ~longest:90) machine)
        [%mel.obj { numRuns = 120 }]));
  describe "state" (fun () ->
    test_async "resets the state below a component replaced by another one with the same output" (fun () ->
      let* root, _ = mount <Switch /> in
      let* () = act (fun () -> click (select root "button")) in
      let counted = inner_html root in
      let* () = act (fun () -> click (select root "i")) in
      expect (counted, inner_html root)
      |. to_equal
           ( "<div><section><button>a1</button></section><i>swap</i></div>",
             "<div><section><button>a0</button></section><i>swap</i></div>" );
      finish ());
    test_async "batches updates and re-renders the component" (fun () ->
      let* root, _ = mount <Counter label="n" /> in
      let* () = act (fun () -> click (select root "button"); click (select root "button")) in
      expect (inner_html root, take ()) |. to_equal ("<button>n2</button>", [ "render n" ]);
      finish ());
    test_async "skips memo children whose props are unchanged" (fun () ->
      let* root, _ = mount <Parent /> in
      let* () = act (fun () -> click (select root "button")) in
      expect (take ()) |. to_equal [ "render parent"; "render quiet moved" ];
      finish ()));
  describe "effects" (fun () ->
    test_async "run children first, layout before passive" (fun () ->
      let root = attached () in
      let client = ReactDOM.Client.createRoot root in
      let* () = act (fun () -> ReactDOM.Client.render client <Effect_tree />) in
      expect (take ())
      |. to_equal
           [ "layout child"; "layout parent"; "passive child"; "deps child x"; "passive parent"; "deps parent a" ];
      finish ());
    test_async "clean up before running again when a dependency changes" (fun () ->
      let* root, _ = mount <Effect_tree /> in
      let* () = act (fun () -> click (select root "button")) in
      expect (take ()) |. to_equal [ "deps cleanup parent a"; "deps parent b" ];
      finish ());
    test_async "clean up everything on unmount" (fun () ->
      let* _, client = mount <Effect_tree /> in
      let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
      expect (List.sort compare (take ()))
      |. to_equal
           [
             "deps cleanup child x"; "deps cleanup parent a"; "layout cleanup child"; "layout cleanup parent";
             "passive cleanup child"; "passive cleanup parent";
           ];
      finish ()));
  describe "context" (fun () ->
    test_async "reaches consumers below memo components" (fun () ->
      let* root, _ = mount <Themed /> in
      let* () = act (fun () -> click (select root "button")) in
      expect (inner_html (select root "em"), take ()) |. to_equal ("blue", [ "render leaf blue" ]);
      finish ()));
  describe "refs" (fun () ->
    test_async "point at the element before effects run" (fun () ->
      let root = attached () in
      let client = ReactDOM.Client.createRoot root in
      let* () = act (fun () -> ReactDOM.Client.render client <Focus />) in
      expect (take ()) |. to_equal [ "ref INPUT" ];
      finish ()));
  describe "refs of an element that goes" (fun () ->
    test_async "are null before effects run, and point at the element again once it is back" (fun () ->
      check_async
        (async_property (tapes ~shortest:1 ~longest:12) (fun values ->
             let tape = tape values in
             let root = attached () in
             let client = ReactDOM.Client.createRoot root in
             let* () = act (fun () -> ReactDOM.Client.render client <Holder />) in
             expect (take ()) |. to_equal [ "callback B"; "object P" ];
             let rec step remaining held =
               match remaining with
               | 0 ->
                   let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
                   expect (take ()) |. to_equal (match held with Held -> [ "callback null" ] | Dropped -> []);
                   finish ()
               | _ ->
                   let next = match (draw tape 2, held) with 0, _ -> held | _, Held -> Dropped | _, Dropped -> Held in
                   let* () = act (fun () -> !held_send (fun _ -> next)) in
                   expect (take ())
                   |. to_equal
                        (match (held, next) with
                        | Held, Held | Dropped, Dropped -> []
                        | Held, Dropped -> [ "callback null"; "object null" ]
                        | Dropped, Held -> [ "callback B"; "object P" ]);
                   step (remaining - 1) next
             in
             step (Array.length values) Held))
        [%mel.obj { numRuns = 40 }]));
  describe "a callback ref replaced by another" (fun () ->
    test_async "calls the old one with null, then the new one with the element, and neither for an unrelated render" (fun () ->
      check_async
        (async_property (tapes ~shortest:1 ~longest:16) (fun values ->
             let tape = tape values in
             let built = match draw tape 2 with 0 -> `Compiled | _ -> `At_run_time in
             let root = attached () in
             let client = ReactDOM.Client.createRoot root in
             let* () = act (fun () -> ReactDOM.Client.render client <Versioned built />) in
             expect (take ()) |. to_equal [ "v0 element" ];
             let rec step remaining version =
               match remaining with
               | 0 ->
                   let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
                   expect (take ()) |. to_equal [ "v" ^ string_of_int version ^ " null" ];
                   finish ()
               | _ -> (
                   match draw tape 2 with
                   | 0 ->
                       let* () = act (fun () -> !versioned_send (fun (version, other) -> (version, other + 1))) in
                       expect (take ()) |. to_equal [];
                       step (remaining - 1) version
                   | _ ->
                       let* () = act (fun () -> !versioned_send (fun (version, other) -> (version + 1, other))) in
                       expect (take ())
                       |. to_equal [ "v" ^ string_of_int version ^ " null"; "v" ^ string_of_int (version + 1) ^ " element" ];
                       step (remaining - 1) (version + 1))
             in
             step (Array.length values) 0))
        [%mel.obj { numRuns = 60 }]));
  describe "forwardRef and svg" (fun () ->
    test_async "forward a ref to an element inside the component" (fun () ->
      let root = attached () in
      let client = ReactDOM.Client.createRoot root in
      let* () = act (fun () -> ReactDOM.Client.render client <Forward />) in
      expect (take ()) |. to_equal [ "forwarded INPUT name" ];
      finish ());
    test_async "create a component's svg root in the svg namespace" (fun () ->
      let* root, _ = mount <svg><Icon d="M0 0L9 9" /></svg> in
      expect (namespace_uri (select root "path"), inner_html root)
      |. to_equal ("http://www.w3.org/2000/svg", "<svg><path d=\"M0 0L9 9\"></path></svg>");
      finish ()));
  describe "rows reading outer state" (fun () ->
    test_async "show the chosen row and the suffix after any actions" (fun () ->
      check_async
        (async_property (tapes ~shortest:4 ~longest:40) (fun values ->
             let tape = tape values in
             let* root, client = mount <Marked /> in
             let rec step remaining marked =
               match remaining with
               | 0 ->
                   let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
                   finish ()
               | _ ->
                   let ids = Array.map (fun entry -> entry.id) marked.entries in
                   let pick () =
                     match Array.length ids with 0 -> None | count -> Some ids.(draw tape count)
                   in
                   let message =
                     match draw tape 4 with
                     | 0 -> Choose (match draw tape 3 with 0 -> None | _ -> pick ())
                     | 1 -> Suffix [| ""; "!"; "?" |].(draw tape 3)
                     | 2 -> Option.fold ~none:Grow ~some:(fun id -> Drop id) (pick ())
                     | _ -> Grow
                   in
                   let marked = mark marked message in
                   let* () = act (fun () -> !marked_send message) in
                   expect (inner_html root) |. to_equal (marked_html marked);
                   step (remaining - 1) marked
             in
             step 10 marked_start))
        [%mel.obj { numRuns = 60 }]));
  describe "lists written in any of reason-react's forms" (fun () ->
    test_async "show the labels in order, numbered where the row reads its index, after any edits" (fun () ->
      check_async
        (async_property (tapes ~shortest:4 ~longest:60) (fun values ->
             let tape = tape values in
             let form = forms.(draw tape (Array.length forms)) in
             let* root, client = mount <Forms form /> in
             let pool = [| "a"; "b"; "c"; "d"; "e"; "f" |] in
             let rec step remaining listing =
               match remaining with
               | 0 ->
                   let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
                   finish ()
               | _ ->
                   let listing =
                     match draw tape 3 with
                     | 0 -> { listing with suffix = [| ""; "!"; "?" |].(draw tape 3) }
                     | _ ->
                         let ranked = Array.map (fun label -> (draw tape 100, label)) pool in
                         Array.stable_sort compare ranked;
                         { listing with labels = Array.sub (Array.map snd ranked) 0 (draw tape 7) }
                   in
                   let* () = act (fun () -> !listing_send (fun _ -> listing)) in
                   expect (inner_html root) |. to_equal (listing_html form listing);
                   step (remaining - 1) listing
             in
             step 10 { labels = [||]; suffix = "" }))
        [%mel.obj { numRuns = 120 }]));
  describe "values written in the props of children" (fun () ->
    test_async "closures, styles, arrays, tuples and children in props see the state of the latest render" (fun () ->
      check_async
        (async_property (tapes ~shortest:4 ~longest:60) (fun values ->
             let tape = tape values in
             let* root, client = mount <Tallied /> in
             let rec step remaining tally =
               match remaining with
               | 0 ->
                   let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
                   finish ()
               | _ ->
                   let tally, action =
                     match draw tape 4 with
                     | 0 ->
                         let step = 1 + draw tape 3 in
                         ({ tally with step }, fun () -> !tally_send (fun current -> { current with step }))
                     | 1 ->
                         let label = [| "a"; "b" |].(draw tape 2) in
                         ({ tally with label }, fun () -> !tally_send (fun current -> { current with label }))
                     | 2 -> ({ tally with total = tally.total + tally.step }, fun () -> click (select root ".leaf"))
                     | _ -> ({ tally with total = tally.total + 1 }, fun () -> click (select root ".leaf + .leaf"))
                   in
                   let* () = act action in
                   expect
                     ( text_content root,
                       style_property (style (select root ".leaf")) "color",
                       style_property (style (select root ".leaf + .leaf")) "color" )
                   |. to_equal (tallied_text tally, (match tally.label with "a" -> "red" | _ -> "blue"), "green");
                   step (remaining - 1) tally
             in
             step 12 tally_start))
        [%mel.obj { numRuns = 120 }]));
  describe "server rendering" (fun () ->
    test_async "hydrating the server's HTML creates no element and then updates like a render" (fun () ->
      check_async
        (async_property (tapes ~shortest:2 ~longest:8) (fun values ->
             let tape = tape values in
             let start = draw tape 4 and clicks = draw tape 4 in
             let root = attached () in
             set_inner_html root (ReactDOMServer.renderToString <Served start />);
             let creates = spy_on document_prototype "createElement" in
             let client = ref None in
             let* () = act (fun () -> client := Some (ReactDOM.Client.hydrateRoot root <Served start />)) in
             let created = Array.length (calls (mock creates)) in
             restore creates;
             let hydrated = inner_html root in
             let rec click remaining shown =
               match remaining with
               | 0 -> Js.Promise.resolve (List.rev shown)
               | _ ->
                   let* () = act (fun () -> Testing.click (select root "button")) in
                   click (remaining - 1) (inner_html root :: shown)
             in
             let* shown = click clicks [] in
             let* () = act (fun () -> Option.iter (fun client -> ReactDOM.Client.unmount client ()) !client) in
             expect (created, hydrated, shown)
             |. to_equal (0, served start, List.init clicks (fun index -> served (start + index + 1)));
             finish ()))
        [%mel.obj { numRuns = 40 }]));
  describe "React's server HTML" (fun () ->
    test_async "React's renderToString of a page hydrates into that page with the server's own elements, and then patches"
      (fun () ->
        check_async
          (async_property (tapes ~shortest:4 ~longest:40) (fun values ->
               let tape = tape values in
               let first = shaped tape 3 in
               let pages = List.rev (snd (List.fold_left (fun (shape, made) _ -> let next = alter tape shape in (next, next :: made)) (first, []) [ 1; 2; 3 ])) in
               let root = attached () and fresh = attached () in
               set_inner_html root (render_real (real first));
               let sent = nodes (select_all root "*") in
               let client = ref None in
               let* () = act (fun () -> client := Some (ReactDOM.Client.hydrateRoot root (page first))) in
               let present = nodes (select_all root "*") in
               let foreign =
                 Array.length (Js.Array.filter ~f:(fun node -> not (Array.exists (fun other -> same node other) sent)) present)
                 + Array.length (Js.Array.filter ~f:(fun node -> not (Array.exists (fun other -> same node other) present)) sent)
               in
               let* fresh_client = act (fun () -> ()) |> Js.Promise.then_ (fun () -> Js.Promise.resolve (ReactDOM.Client.createRoot fresh)) in
               let* () = act (fun () -> ReactDOM.Client.render fresh_client (page first)) in
               let hydrated = (shapes (as_node root), shapes (as_node fresh)) in
               let rec patch remaining seen =
                 match remaining with
                 | [] -> Js.Promise.resolve (List.rev seen)
                 | next :: rest ->
                     let* () = act (fun () -> Option.iter (fun client -> ReactDOM.Client.render client (page next)) !client) in
                     let* () = act (fun () -> ReactDOM.Client.render fresh_client (page next)) in
                     patch rest ((shapes (as_node root), shapes (as_node fresh)) :: seen)
               in
               let* patched = patch pages [] in
               let* () =
                 act (fun () ->
                     Option.iter (fun client -> ReactDOM.Client.unmount client ()) !client;
                     ReactDOM.Client.unmount fresh_client ())
               in
               ignore (take ());
               expect (foreign, fst hydrated, List.map fst patched) |. to_equal (0, snd hydrated, List.map snd patched);
               finish ()))
          [%mel.obj { numRuns = 300 }]));
  describe "forms" (fun () ->
    test_async "a controlled input and checkbox show the state after any input, kept or rejected, in the value attribute too"
      (fun () ->
        check_async
          (async_property (tapes ~shortest:2 ~longest:16) (fun values ->
               let tape = tape values in
               let words = [| "12"; "a"; "3b4"; ""; "x9" |] in
               let actions =
                 List.init 8 (fun _ ->
                     let word = words.(draw tape (Array.length words)) in
                     match draw tape 2 with 0 -> `Type word | _ -> `Click)
               in
               let _, wanted =
                 List.fold_left_map
                   (fun shown action ->
                     let shown = match action with `Type word -> digits word | `Click -> shown in
                     (shown, (shown, shown, false)))
                   "" actions
               in
               let* root, client = mount <Controlled /> in
               let field = select root "input" and box = select root "input[type=checkbox]" in
               let rec step remaining shown =
                 match remaining with
                 | [] ->
                     let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
                     Js.Promise.resolve (List.rev shown)
                 | action :: rest ->
                     let* () =
                       act (fun () ->
                           match action with
                           | `Type word ->
                               type_into field word;
                               dispatch field (bubbling "input" [%mel.obj { bubbles = true }])
                           | `Click -> click box)
                     in
                     let* () = paused 0 in
                     step rest ((value_of field, get_attribute field "value", checked box) :: shown)
               in
               let* shown = step actions [] in
               expect shown |. to_equal wanted;
               finish ()))
          [%mel.obj { numRuns = 60 }]));
  describe "checkboxes" (fun () ->
    test_async "a controlled checkbox has the checked attribute exactly when it was checked at mount" (fun () ->
      check_async
        (async_property (tapes ~shortest:2 ~longest:20) (fun values ->
             let tape = tape values in
             let first = draw tape 2 = 1 in
             let steps = List.init (1 + draw tape 8) (fun _ -> draw tape 3) in
             let* root, client = mount <Boxed generation=0 initial=first /> in
             let rec run remaining generation on mounted seen =
               match remaining with
               | [] -> Js.Promise.resolve (List.rev seen)
               | step :: rest ->
                   let generation, on, mounted =
                     match step with
                     | 0 -> (generation + 1, on, on)
                     | _ -> (generation, not on, mounted)
                   in
                   let* () =
                     act (fun () ->
                         match step with
                         | 0 -> ReactDOM.Client.render client <Boxed generation initial=on />
                         | _ -> click (select root "input"))
                   in
                   let box = select root "input" in
                   run rest generation on mounted (((checked box, has_attribute box "checked"), (on, mounted)) :: seen)
             in
             let* seen = run steps 0 first first [] in
             let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
             expect (List.map fst seen) |. to_equal (List.map snd seen);
             finish ()))
          [%mel.obj { numRuns = 60 }]));
  describe "disabled" (fun () ->
    test_async "a disabled button's own mouse handlers do not run, its parents' do" (fun () ->
      check_async
        (async_property (tapes ~shortest:2 ~longest:20) (fun values ->
             let tape = tape values in
             let steps = List.init (1 + draw tape 6) (fun _ -> (draw tape 2 = 0, draw tape 2, draw tape 2)) in
             let* root, client = mount <Guarded disabled=false /> in
             let rec run remaining =
               match remaining with
               | [] -> Js.Promise.resolve ()
               | (disabled, kind, target) :: rest ->
                   let* () = act (fun () -> ReactDOM.Client.render client <Guarded disabled />) in
                   let* () =
                     act (fun () ->
                         let element = select root (match target with 0 -> "b" | _ -> "button") in
                         match kind with
                         | 0 -> dispatch element (bubbling "click" [%mel.obj { bubbles = true }])
                         | _ -> dispatch element (bubbling "mousedown" [%mel.obj { bubbles = true }]))
                   in
                   run rest
             in
             let* () = run steps in
             let seen = take () in
             let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
             let expected =
               List.concat_map
                 (fun (disabled, kind, _) ->
                   let name = match kind with 0 -> "click" | _ -> "down" in
                   (match disabled with true -> [] | false -> [ "button " ^ name ]) @ [ "outer " ^ name ])
                 steps
             in
             expect seen |. to_equal expected;
             finish ()))
        [%mel.obj { numRuns = 60 }]));
  describe "router" (fun () ->
    test_async "useUrl shows every URL pushed or replaced, parsed as reason-react parses it" (fun () ->
      let addresses =
        [|
          ("/", "#?");
          ("/a/b", "a/b#?");
          ("/a/b/", "a/b#?");
          ("/books#title", "books#title?");
          ("/c?q=2#h", "c#h?q=2");
          ("/x//y", "x/y#?");
          ("/d/?r=1", "d#?r=1");
        |]
      in
      check_async
        (async_property (tapes ~shortest:2 ~longest:30) (fun values ->
             let tape = tape values in
             let steps =
               List.init (1 + draw tape 6) (fun _ ->
                   (addresses.(draw tape (Array.length addresses)), match draw tape 2 with 0 -> `Push | _ -> `Replace))
             in
             ReasonReactRouter.replace "/";
             let adds = spy_on window_object "addEventListener" in
             let removes = spy_on window_object "removeEventListener" in
             let* root, client = mount <Address /> in
             let rec run remaining seen =
               match remaining with
               | [] -> Js.Promise.resolve (List.rev seen)
               | ((address, _), change) :: rest ->
                   let* () =
                     act (fun () ->
                         match change with
                         | `Push -> ReasonReactRouter.push address
                         | `Replace -> ReasonReactRouter.replace address)
                   in
                   run rest (inner_html root :: seen)
             in
             let* seen = run steps [] in
             let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
             let popstate spy =
               List.length (List.filter (fun call -> String.equal call.(0) "popstate") (Array.to_list (calls (mock spy))))
             in
             let left = popstate adds - popstate removes in
             restore adds;
             restore removes;
             let requested = List.filter (fun ((address, _), _) -> not (String.contains address '#')) steps in
             let served =
               List.map
                 (fun ((address, _), _) ->
                   let url = ReasonReactRouter.dangerouslyGetInitialUrl ~serverUrlString:address () in
                   String.concat "/" url.path ^ "?" ^ url.search)
                 requested
             in
             let parsed =
               List.map
                 (fun ((_, shown), _) ->
                   match String.split_on_char '#' shown with
                   | [ path; rest ] -> path ^ "?" ^ List.nth (String.split_on_char '?' rest) 1
                   | _ -> shown)
                 requested
             in
             expect (seen, left, served)
             |. to_equal (List.map (fun ((_, shown), _) -> "<p>" ^ shown ^ "</p>") steps, 0, parsed);
             finish ()))
        [%mel.obj { numRuns = 60 }]));
  describe "bindings to npm react" (fun () ->
    test_async "hooks bound from npm's react with external work, each call with its own state, as under React" (fun () ->
      check_async
        (async_property (tapes ~shortest:2 ~longest:20) (fun values ->
             let tape = tape values in
             let step = 1 + draw tape 5 in
             let clicks = List.init (1 + draw tape 8) (fun _ -> draw tape 3) in
             let* root, client = mount <Npm_bound step /> in
             let rec run remaining seen =
               match remaining with
               | [] -> Js.Promise.resolve (List.rev seen)
               | which :: rest ->
                   let* () =
                     act (fun () -> click (select root (match which with 0 -> ".add" | 1 -> ".bump" | _ -> ".third")))
                   in
                   run rest
                     (( text_content (select root ".add"),
                        text_content (select root ".bump"),
                        text_content (select root ".third"),
                        take () )
                     :: seen)
             in
             let* seen = run clicks [] in
             let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
             let _, expected =
               List.fold_left_map
                 (fun (total, other, third) which ->
                   let pair total other = "pair " ^ string_of_int total ^ " " ^ string_of_int other in
                   match which with
                   | 0 ->
                       ( (total + step, other, third),
                         ( string_of_int (total + step),
                           string_of_int other,
                           String.uppercase_ascii third,
                           [ "effect " ^ string_of_int (total + step); pair (total + step) other ] ) )
                   | 1 ->
                       ((total, other + 1, third), (string_of_int total, string_of_int (other + 1), String.uppercase_ascii third, [ pair total (other + 1) ]))
                   | _ ->
                       ( (total, other, third ^ "x"),
                         ( string_of_int total,
                           string_of_int other,
                           String.uppercase_ascii (third ^ "x"),
                           [ "memo " ^ third ^ "x"; "eight " ^ string_of_int (String.length third + 1) ] ) ))
                 (0, 10, "") clicks
             in
             expect seen |. to_equal expected;
             finish ()))
          [%mel.obj { numRuns = 60 }]));
  describe "elements built at run time" (fun () ->
    test_async "domProps, createElement with a tag, createElementVariadic and jsx show what React shows, through props, children and clicks" (fun () ->
      check_async
        (async_property (tapes ~shortest:4 ~longest:40) (fun values ->
             let tape = tape values in
             let words = [| "a"; "b c"; ""; "x" |] in
             let shape () =
               let tag = [| "div"; "section"; "p" |].(draw tape 3) in
               let label = words.(draw tape 4) in
               let title = match draw tape 2 with 0 -> None | _ -> Some words.(draw tape 4) in
               let off = draw tape 2 = 1 in
               let tint = match draw tape 3 with 0 -> None | 1 -> Some "red" | _ -> Some "blue" in
               let count = draw tape 4 in
               { tag; label; title; off; tint; count }
             in
             let expected tinted shape clicks =
               let attrs pairs = List.sort compare pairs in
               [
                 Element_shape
                   ( "DIV",
                     [ ("class", "built") ],
                     [
                       Element_shape
                         ( String.uppercase_ascii shape.tag,
                           attrs
                             ([ ("class", shape.label) ]
                             @ Option.fold ~none:[] ~some:(fun title -> [ ("title", title) ]) shape.title
                             @
                             match (shape.tint, tinted) with
                             | Some color, _ -> [ ("style", "color: " ^ color ^ ";") ]
                             | None, Once -> [ ("style", "") ]
                             | None, Never -> []),
                           [ Text_shape (shape.label ^ string_of_int clicks) ] );
                       Element_shape
                         ( "BUTTON",
                           attrs ([ ("class", "b") ] @ match shape.off with true -> [ ("disabled", "") ] | false -> []),
                           [ Text_shape ("go" ^ string_of_int shape.count) ] );
                       Element_shape
                         ( "UL",
                           [ ("id", "list") ],
                           List.init shape.count (fun index -> Element_shape ("LI", [], [ Text_shape (string_of_int index) ])) );
                     ] );
               ]
             in
             let follow before current next =
               match (String.equal current.tag next.tag, before, next.tint) with
               | _, _, Some _ -> Once
               | true, Once, None -> Once
               | true, Never, None | false, _, None -> Never
             in
             let start = shape () in
             let* root, client = mount <Built shape=start /> in
             let rec run remaining current clicks history seen =
               match remaining with
               | 0 -> Js.Promise.resolve (List.rev seen)
               | _ ->
                   let before = select root ".built > :first-child" in
                   let next, clicks = match draw tape 2 with 0 -> (shape (), clicks) | _ -> (current, clicks + 1) in
                   let* () =
                     act (fun () ->
                         match next == current with
                         | false -> ReactDOM.Client.render client <Built shape=next />
                         | true -> click (select root ".built > :first-child"))
                   in
                   let history = follow history current next in
                   let kept =
                     match String.equal current.tag next.tag with
                     | true -> same before (select root ".built > :first-child")
                     | false -> true
                   in
                   run (remaining - 1) next clicks history ((shapes (as_node root), expected history next clicks, kept) :: seen)
             in
             let first = follow Never start start in
             let* seen = run (1 + draw tape 8) start 0 first [ (shapes (as_node root), expected first start 0, true) ] in
             let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
             expect (List.map (fun (shown, _, kept) -> (shown, kept)) seen)
             |. to_equal (List.map (fun (_, wanted, _) -> (wanted, true)) seen);
             finish ()))
          [%mel.obj { numRuns = 80 }]));
  describe "events" (fun () ->
    test_async "React.Event reads what was sent, and prevent and stop act as in React" (fun () ->
      check_async
        (async_property (tapes ~shortest:4 ~longest:60) (fun values ->
             let tape = tape values in
             let keys = [| "a"; "Enter"; "Escape"; "ArrowLeft"; " " |] in
             let sent =
               List.init (1 + draw tape 6) (fun _ ->
                   let bit () = draw tape 2 = 1 in
                   let event =
                     match draw tape 2 with
                     | 0 ->
                         Mouse
                           { x = draw tape 500; y = draw tape 500; button = draw tape 2; shift = bit (); alt = bit ();
                             ctrl = bit (); meta = bit () }
                     | _ -> Key { key = keys.(draw tape (Array.length keys)); shift = bit (); ctrl = bit (); repeat = bit () }
                   in
                   let inner = match draw tape 2 with 0 -> "button" | _ -> "b" in
                   let treatment =
                     { prevent = (match draw tape 2 with 0 -> `Prevent | _ -> `Allow);
                       stop = (match draw tape 2 with 0 -> `Stop | _ -> `Bubble) }
                   in
                   (event, inner, treatment))
             in
             let expected =
               List.concat_map
                 (fun (event, inner, treatment) ->
                   let prevented = match treatment.prevent with `Prevent -> true | `Allow -> false in
                   let stopped = match treatment.stop with `Stop -> true | `Bubble -> false in
                   let reading =
                     match event with
                     | Mouse { x; y; button; shift; alt; ctrl; meta } ->
                         String.concat " "
                           [ "click"; "BUTTON"; String.uppercase_ascii inner; string_of_int x; string_of_int y;
                             string_of_int button; flags [ shift; alt; ctrl; meta; prevented; stopped ] ]
                     | Key { key; shift; ctrl; repeat } ->
                         String.concat " "
                           [ "keydown"; "BUTTON"; String.uppercase_ascii inner; key;
                             flags [ shift; ctrl; repeat; prevented; stopped ] ]
                   in
                   let bubbled = match treatment.stop with `Stop -> [] | `Bubble -> [ "section SECTION" ] in
                   (reading :: bubbled) @ [ "kept " ^ flags [ not prevented ]; "released 1" ])
                 sent
             in
             let* root, client = mount <Probe /> in
             let* () =
               act (fun () ->
                   List.iter
                     (fun (event, inner, chosen) ->
                       treatment := chosen;
                       let native =
                         match event with
                         | Mouse { x; y; button; shift; alt; ctrl; meta } ->
                             mouse_event "click"
                               [%mel.obj
                                 { bubbles = true; cancelable = true; clientX = x; clientY = y; button; shiftKey = shift;
                                   altKey = alt; ctrlKey = ctrl; metaKey = meta }]
                         | Key { key; shift; ctrl; repeat } ->
                             keyboard_event "keydown"
                               [%mel.obj { bubbles = true; cancelable = true; key; shiftKey = shift; ctrlKey = ctrl; repeat }]
                       in
                       let kept = dispatch_kept (select root inner) native in
                       log ("kept " ^ flags [ kept ]);
                       log ("released " ^ flags [ Option.is_none (Js.Null.toOption (current_target_of native)) ]))
                     sent)
             in
             let seen = take () in
             let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
             expect seen |. to_equal expected;
             finish ()))
        [%mel.obj { numRuns = 100 }]));
  describe "error boundaries" (fun () ->
    test_async "show the fallback of the nearest boundary for errors in render, updates and effects" (fun () ->
      check_async (async_property (tapes ~shortest:10 ~longest:80) minefield) [%mel.obj { numRuns = 1000 }]);
    test_async "show the fallback for an error in a passive effect without any further update" (fun () ->
      let loud = quiet_errors () in
      let* root, _ = mount <Minefield mines=[ Bomb { name = "late"; fuse = Clicks (1, Painting); arrival = 0 } ] /> in
      Hashtbl.find bumps "late" ();
      let* () = paused 100 in
      loud ();
      expect (inner_html root) |. to_equal "<main><i>late</i></main>";
      finish ()));
  describe "hooks from reason-react 0.17" (fun () ->
    test_async "insertion effects with four and seven dependencies, a store with a server snapshot, a deferred value and useTransitionAsync" (fun () ->
      check_async
        (async_property (tapes ~shortest:2 ~longest:30) (fun values ->
             let tape = tape values in
             let letters = [| "x"; "y" |] in
             store := 0;
             let* root, client = mount <Fresh_hooks a="x" b="x" c="x" d="x" /> in
             let rec run remaining (a, b, c, d, shared) =
               match remaining with
               | 0 -> Js.Promise.resolve ()
               | _ -> (
                   match draw tape 2 with
                   | 0 ->
                       let* () = act (fun () -> click (select root "button")) in
                       expect (inner_html (select root "p"), take ())
                       |. to_equal
                            ( a ^ b ^ "/" ^ string_of_int (shared + 1) ^ "/false<button>go</button>",
                              [] );
                       run (remaining - 1) (a, b, c, d, shared + 1)
                   | _ ->
                       let a' = letters.(draw tape 2) and b' = letters.(draw tape 2)
                       and c' = letters.(draw tape 2) and d' = letters.(draw tape 2) in
                       let* () = act (fun () -> ReactDOM.Client.render client <Fresh_hooks a=a' b=b' c=c' d=d' />) in
                       let inserted =
                         match (a, b, c, d) = (a', b', c', d') with
                         | true -> []
                         | false -> [ "insert " ^ a' ^ b' ^ c' ^ d' ]
                       and seven = match (a, d) = (a', d') with true -> [] | false -> [ "seven " ^ a' ^ d' ] in
                       expect (inner_html (select root "p"), take ())
                       |. to_equal
                            ( a' ^ b' ^ "/" ^ string_of_int shared ^ "/false<button>go</button>",
                              inserted @ seven );
                       run (remaining - 1) (a', b', c', d', shared))
             in
             let* () = run (1 + draw tape 10) ("x", "x", "x", "x", 0) in
             let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
             ignore (take ());
             finish ()))
        [%mel.obj { numRuns = 80 }]));
  describe "ReactDOMTestUtils" (fun () ->
    test_async "Simulate, DOM and the container helpers drive a page as under React" (fun () ->
      check_async
        (async_property (tapes ~shortest:2 ~longest:30) (fun values ->
             let tape = tape values in
             let container = ref None in
             ReactDOMTestUtils.prepareContainer container ();
             let root = ReactDOMTestUtils.getContainer container in
             let client = ReactDOM.Client.createRoot root in
             ReactDOMTestUtils.act (fun () -> ReactDOM.Client.render client <Probe_utils />);
             ignore (take ());
             let words = [| ""; "a"; "abcd"; "xy" |] in
             let find selector = Option.get (ReactDOMTestUtils.DOM.findBySelector root selector) in
             let rec run remaining (count, text, ticked) =
               match remaining with
               | 0 -> ()
               | _ ->
                   let next, logged =
                     match draw tape 5 with
                     | 0 ->
                         ReactDOMTestUtils.act (fun () -> ReactDOMTestUtils.Simulate.click (find "button"));
                         ((count + 1, text, ticked), [])
                     | 1 ->
                         let word = words.(draw tape 4) in
                         ReactDOMTestUtils.act (fun () -> ReactDOMTestUtils.Simulate.changeWithValue (find ".text") word);
                         ((count, String.sub word 0 (min 3 (String.length word)), ticked), [])
                     | 2 ->
                         let checked = draw tape 2 = 0 in
                         ReactDOMTestUtils.act (fun () -> ReactDOMTestUtils.Simulate.changeWithChecked (find ".tick") checked);
                         ((count, text, checked), [])
                     | 3 ->
                         ReactDOMTestUtils.act (fun () -> ReactDOMTestUtils.Simulate.focus (find ".text"));
                         ((count, text, ticked), [ "focus" ])
                     | _ ->
                         ReactDOMTestUtils.act (fun () -> ReactDOMTestUtils.Simulate.blur (find ".text"));
                         ((count, text, ticked), [ "blur" ])
                   in
                   let count, text, ticked = next in
                   expect
                     ( Option.map text_content (ReactDOMTestUtils.DOM.findBySelectorAndTextContent root "button" (string_of_int count)),
                       ReactDOMTestUtils.DOM.value (find ".text"),
                       (dom_property (find ".tick") "checked" : bool),
                       Option.map text_content
                         (ReactDOMTestUtils.DOM.findBySelectorAndPartialTextContent root "p" ("|" ^ string_of_bool ticked)),
                       Array.length (ReactDOMTestUtils.DOM.findByAllSelector root "input"),
                       take () )
                   |. to_equal
                        ( Some (string_of_int count),
                          Some text,
                          ticked,
                          Some (text ^ "|" ^ string_of_bool ticked),
                          2,
                          logged );
                   run (remaining - 1) next
             in
             run (1 + draw tape 12) (0, "", false);
             expect
               ( ReactDOMTestUtils.isDOMComponent root,
                 ReactDOMTestUtils.isElement <i />,
                 ReactDOMTestUtils.isElement "text",
                 ReactDOMTestUtils.isCompositeComponent root )
             |. to_equal (true, true, false, false);
             ReactDOMTestUtils.act (fun () -> ReactDOM.Client.unmount client ());
             ReactDOMTestUtils.cleanupContainer container ();
             expect !container |. to_equal None;
             finish ()))
        [%mel.obj { numRuns = 80 }]));
  describe "elements from npm react's createElement and jsx" (fun () ->
    test_async "bindings to createElement, jsx, jsxs and Fragment build Melact elements, as React builds its own" (fun () ->
      check_async
        (async_property (tapes ~shortest:2 ~longest:20) (fun values ->
             let tape = tape values in
             let* root, client = mount <Npm_elements label="a" /> in
             let rec run remaining (label, count) =
               let shown =
                 "<section class=\"npm\"><h1 id=\"x\">" ^ label ^ "</h1><button>" ^ string_of_int count
                 ^ "</button><em>jsx</em><ul><li>" ^ label ^ "</li><li>z</li></ul>frag<b>"
                 ^ String.uppercase_ascii label ^ "</b></section>"
               in
               expect (inner_html root) |. to_equal shown;
               match remaining with
               | 0 -> Js.Promise.resolve ()
               | _ -> (
                   match draw tape 2 with
                   | 0 ->
                       let* () = act (fun () -> click (select root "button")) in
                       run (remaining - 1) (label, count + 1)
                   | _ ->
                       let label = [| "a"; "b" |].(draw tape 2) in
                       let* () = act (fun () -> ReactDOM.Client.render client <Npm_elements label />) in
                       run (remaining - 1) (label, count))
             in
             let* () = run (1 + draw tape 10) ("a", 0) in
             let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
             ignore (take ());
             finish ()))
        [%mel.obj { numRuns = 60 }]));
  describe "styles and React.null" (fun () ->
    test_async "a custom CSS property is set, changed and removed beside an ordinary one, as React does" (fun () ->
      check_async
        (async_property (tapes ~shortest:1 ~longest:20) (fun values ->
             let tape = tape values in
             let customs = [| None; Some "4px"; Some "1em" |] and colors = [| None; Some "red"; Some "blue" |] in
             let* root, client = mount <Painted custom=None color=None /> in
             let rec run remaining =
               match remaining with
               | 0 -> Js.Promise.resolve ()
               | _ ->
                   let custom = customs.(draw tape 3) and color = colors.(draw tape 3) in
                   let* () = act (fun () -> ReactDOM.Client.render client <Painted custom color />) in
                   let shown = style (select root "div") in
                   expect (property_value shown "--gapSize", style_property shown "color")
                   |. to_equal (Option.value ~default:"" custom, Option.value ~default:"" color);
                   run (remaining - 1)
             in
             let* () = run (1 + draw tape 8) in
             let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
             finish ()))
        [%mel.obj { numRuns = 60 }]);
    test_async "an element compares with React.null structurally (Reason's ==), either way round, without a closure in the way" (fun () ->
      let* empty, _ = mount <Optional_child /> in
      let* full, _ = mount <Optional_child><b>(React.string "x")</b></Optional_child> in
      expect (inner_html empty, inner_html full) |. to_equal ("<p>none</p>", "<p>some<b>x</b></p>");
      finish ()));
  describe "lists and conditions" (fun () ->
    test_async "React.createElement and React.jsxKeyed with makeProps keep rows and their state exactly as JSX does" (fun () ->
      check_async
        (async_property (tapes ~shortest:4 ~longest:40) (fun values ->
             let tape = tape values in
             let pool = [| "a"; "b"; "c"; "d"; "e" |] in
             let steps =
               List.init (1 + draw tape 8) (fun _ ->
                   match draw tape 2 with
                   | 0 -> `Show (Array.of_list (List.filter (fun _ -> draw tape 2 = 0) (Array.to_list pool)))
                   | _ -> `Click (draw tape 5))
             in
             let* written, written_client = mount <Rows labels=[| "a"; "b"; "c" |] /> in
             let* created, created_client = mount <Created_rows labels=[| "a"; "b"; "c" |] /> in
             let* jsx, jsx_client = mount <Jsx_rows labels=[| "a"; "b"; "c" |] /> in
             let rec run remaining seen =
               match remaining with
               | [] -> Js.Promise.resolve (List.rev seen)
               | step :: rest ->
                   let* () =
                     act (fun () ->
                         match step with
                         | `Show labels ->
                             ReactDOM.Client.render written_client <Rows labels />;
                             ReactDOM.Client.render created_client <Created_rows labels />;
                             ReactDOM.Client.render jsx_client <Jsx_rows labels />
                         | `Click index ->
                             List.iter
                               (fun root ->
                                 let buttons = nodes (select_all root "button") in
                                 Option.iter click
                                   (match Array.length buttons with
                                   | 0 -> None
                                   | count -> Some (element_of buttons.(index mod count))))
                               [ written; created; jsx ])
                   in
                   run rest ((inner_html written, (inner_html created, inner_html jsx)) :: seen)
             in
             let* seen = run steps [] in
             let* () =
               act (fun () ->
                   ReactDOM.Client.unmount written_client ();
                   ReactDOM.Client.unmount created_client ();
                   ReactDOM.Client.unmount jsx_client ())
             in
             ignore (take ());
             expect (List.map snd seen) |. to_equal (List.map (fun (written, _) -> (written, written)) seen);
             finish ()))
        [%mel.obj { numRuns = 60 }]);
    test_async "code typed against React.component: a wrapper, a hand-written module, memo and component" (fun () ->
      check_async
        (async_property (tapes ~shortest:2 ~longest:30) (fun values ->
             let tape = tape values in
             let labels = [| "p"; "q" |] and texts = [| "hi"; "yo"; "" |] in
             let* root, client = mount <Typed label="p" text="hi" /> in
             let rec run remaining (label, text, bordered, remembered) =
               match remaining with
               | 0 -> Js.Promise.resolve ()
               | _ ->
                   let step = draw tape 4 in
                   let next =
                     match step with
                     | 0 -> (label, text, bordered + 1, remembered)
                     | 1 -> (label, text, bordered, remembered + 1)
                     | 2 -> (labels.(draw tape 2), text, bordered, remembered)
                     | _ -> (label, texts.(draw tape 3), bordered, remembered)
                   in
                   let label', text', _, _ = next in
                   let* () =
                     act (fun () ->
                         match step with
                         | 0 -> click (select root ".border button")
                         | 1 -> click (select root "section > button")
                         | _ -> ReactDOM.Client.render client <Typed label=label' text=text' />)
                   in
                   let _, _, bordered', remembered' = next in
                   expect (inner_html root)
                   |. to_equal
                        ("<section><div class=\"border\"><button>" ^ label' ^ string_of_int bordered'
                       ^ "</button></div><b>" ^ String.uppercase_ascii text' ^ "</b><button>" ^ label'
                       ^ string_of_int remembered' ^ "</button><i>" ^ text' ^ "</i></section>");
                   run (remaining - 1) next
             in
             let* () = run (1 + draw tape 10) ("p", "hi", 0, 0) in
             let* () = act (fun () -> ReactDOM.Client.unmount client ()) in
             ignore (take ());
             finish ()))
        [%mel.obj { numRuns = 80 }]);
    test_async "keep component state with its key" (fun () ->
      let* root, client = mount <Rows labels=[| "a"; "b"; "c" |] /> in
      let* () = act (fun () -> click (select root "button")) in
      let* () = act (fun () -> ReactDOM.Client.render client <Rows labels=[| "c"; "a"; "d" |] />) in
      expect (inner_html root)
      |. to_equal "<div><button>c0</button><button>a1</button><button>d0</button></div>";
      finish ());
    test_async "show and hide content between siblings" (fun () ->
      let* root, _ = mount <Toggle /> in
      let* () = act (fun () -> click (select root "button")) in
      let shown = inner_html root in
      let* () = act (fun () -> click (select root "button")) in
      expect (shown, inner_html root)
      |. to_equal
           ( "<p>&lt;<b>on</b>&gt;<button>toggle</button></p>",
             "<p>&lt;&gt;<button>toggle</button></p>" );
      finish ()))
