module Focus = struct
  let[@react.component] make () =
    let input = React.useRef Js.Nullable.null in
    React.useEffect0 (fun () ->
      Option.iter (fun element -> log ("ref " ^ tag_name element)) (Js.Nullable.toOption input.current);
      None);
    <input ref=(ReactDOM.Ref.domRef input) />
end

(** Whether the element that holds the refs is on the page. *)
type held = Held | Dropped

let held_send = ref (fun (_ : held -> held) -> ())

let seen kind element =
  log (Option.fold ~none:(kind ^ " null") ~some:(fun element -> kind ^ " " ^ tag_name element) (Js.Nullable.toOption element))

let called = ReactDOM.Ref.callbackDomRef (seen "callback")

module Holder = struct
  let[@react.component] make () =
    let held, setHeld = React.useState (fun () -> Held) in
    let target = React.useRef Js.Nullable.null in
    held_send := setHeld;
    React.useEffect (fun () -> seen "object" target.current; None);
    match held with
    | Held -> <p ref=(ReactDOM.Ref.domRef target)><b ref=called /></p>
    | Dropped -> <span />
end

module Fancy_input = struct
  let[@react.component] make = React.forwardRef (fun ~label ref ->
    let ref = Option.map ReactDOM.Ref.domRef (Js.Nullable.toOption ref) in
    <input placeholder=label ?ref />)
end

module Forward = struct
  let[@react.component] make () =
    let input = React.useRef Js.Nullable.null in
    React.useEffect0 (fun () ->
      Option.iter
        (fun element -> log ("forwarded " ^ tag_name element ^ " " ^ get_attribute element "placeholder"))
        (Js.Nullable.toOption input.current);
      None);
    <Fancy_input label="name" ref=(ReactDOM.Ref.domRef input) />
end

