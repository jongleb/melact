[@@@alert "-deprecated"]
open Testing

external test_async : string -> (unit -> unit Js.Promise.t) -> unit = "test"
external tag_name : Dom.element -> string = "tagName" [@@mel.get]
external namespace_uri : Dom.element -> string = "namespaceURI" [@@mel.get]
external get_attribute : Dom.element -> string -> string = "getAttribute" [@@mel.send]
external select_all : Dom.element -> string -> Dom.nodeList = "querySelectorAll" [@@mel.send]
external element_of : Dom.node -> Dom.element = "%identity"
external window_object : prototype = "window"

external adopt : unit Js.Promise.t -> unit Js.Promise.t = "resolve" [@@mel.scope "Promise"]

let ( let* ) promise next = Js.Promise.then_ next promise
let act run = adopt (React.act run)
let events = ref []
let log event = events := event :: !events

let take () =
  let taken = List.rev !events in
  events := [];
  taken

let mount element =
  let root = attached () in
  let client = ReactDOM.Client.createRoot root in
  let* () = act (fun () -> ReactDOM.Client.render client element) in
  ignore (take ());
  Js.Promise.resolve (root, client)

let finish () = Js.Promise.resolve ()

module Counter = struct
  let[@react.component] make ~label =
    let count, setCount = React.useState (fun () -> 0) in
    log ("render " ^ label);
    <button onClick=(fun _ -> setCount (fun n -> n + 1))>
      (React.string (label ^ string_of_int count))
    </button>
end

external npmUseReducer : (('state -> 'action -> 'state)[@mel.uncurry]) -> 'state -> 'state * ('action -> unit) = "useReducer"
[@@mel.module "react"]

module Npm = struct
  external useEffect : (unit -> (unit -> unit) option) -> 'deps array -> unit = "useEffect" [@@mel.module "react"]
end

external npmUseEffect2 : (unit -> (unit -> unit) option) -> 'a * 'b -> unit = "useEffect" [@@mel.module "react"]

module Npm_bound = struct
  let[@react.component] make ~step =
    let total, add = npmUseReducer (fun total by -> total + by) 0 in
    let other, bump = npmUseReducer (fun count () -> count + 1) 10 in
    let third, setThird = Npm_hooks.useState (fun () -> "") in
    let shouted =
      Npm_hooks.useMemo8 (fun () -> log ("memo " ^ third); String.uppercase_ascii third) (third, 1, 2, 3, 4, 5, 6, "seven")
    in
    Npm.useEffect (fun () -> log ("effect " ^ string_of_int total); None) [| total |];
    npmUseEffect2 (fun () -> log ("pair " ^ string_of_int total ^ " " ^ string_of_int other); None) (total, other);
    Npm_hooks.useEffect8
      (fun () -> log ("eight " ^ string_of_int (String.length third)); None)
      [| String.length third; 1; 2; 3; 4; 5; 6; 7 |];
    <p>
      <button className="add" onClick=(fun _ -> add step)>(React.int total)</button>
      <button className="bump" onClick=(fun _ -> bump ())>(React.int other)</button>
      <button className="third" onClick=(fun _ -> setThird (fun text -> text ^ "x"))>(React.string shouted)</button>
    </p>
end


(** What the run-time DOM element shows: its tag, props and children. *)
type built_shape = { tag : string; label : string; title : string option; off : bool; tint : string option; count : int }

(** Whether the first element has had a style since it was created; React then keeps [style=""]. *)
type tinted = Never | Once

module Built = struct
  let[@react.component] make ~shape =
    let clicks, setClicks = React.useState (fun () -> 0) in
    let style = Option.map (fun color -> ReactDOM.Style.make ~color ()) shape.tint in
    let first =
      React.createElement
        (ReactDOM.stringToComponent shape.tag)
        (ReactDOM.domProps ~className:shape.label ?title:shape.title ?style
           ~onClick:(fun _ -> setClicks (fun n -> n + 1))
           ~children:(React.string (shape.label ^ string_of_int clicks)) ())
    in
    let second =
      ReactDOM.createElement "button" ~props:(ReactDOM.domProps ~disabled:shape.off ~className:"b" ())
        [| React.string "go"; React.int shape.count |]
    in
    let third =
      React.createElementVariadic (ReactDOM.stringToComponent "ul") (ReactDOM.domProps ~id:"list" ())
        (Array.init shape.count (fun index -> ReactDOM.jsx "li" (ReactDOM.domProps ~key:(string_of_int index) ~children:(React.int index) ())))
    in
    <div className="built">first second third</div>
end

module Plain_a = struct
  let[@react.component] make () = <section><Counter label="a" /></section>
end

module Plain_b = struct
  let[@react.component] make () = <section><Counter label="a" /></section>
end

module Switch = struct
  let[@react.component] make () =
    let first, setFirst = React.useState (fun () -> true) in
    <div>
      (if first then <Plain_a /> else <Plain_b />)
      <i onClick=(fun _ -> setFirst (fun first -> not first))>(React.string "swap")</i>
    </div>
end

module Quiet = struct
  let[@react.component] make = React.memo (fun ~label ->
    log ("render quiet " ^ label);
    <span>(React.string label)</span>)
end

module Parent = struct
  let[@react.component] make () =
    let n, setN = React.useState (fun () -> 0) in
    log "render parent";
    <div>
      <button onClick=(fun _ -> setN (fun n -> n + 1))>(React.int n)</button>
      <Quiet label="fixed" />
      <Quiet label=(if n > 0 then "moved" else "still") />
    </div>
end

module Effects = struct
  let[@react.component] make ~name ~dep =
    React.useLayoutEffect0 (fun () ->
      log ("layout " ^ name);
      Some (fun () -> log ("layout cleanup " ^ name)));
    React.useEffect0 (fun () ->
      log ("passive " ^ name);
      Some (fun () -> log ("passive cleanup " ^ name)));
    React.useEffect1 (fun () ->
      log ("deps " ^ name ^ " " ^ dep);
      Some (fun () -> log ("deps cleanup " ^ name ^ " " ^ dep)))
      [| dep |];
    React.null
end

module Effect_tree = struct
  let[@react.component] make () =
    let dep, setDep = React.useState (fun () -> "a") in
    <div>
      <button onClick=(fun _ -> setDep (fun _ -> "b"))>(React.string dep)</button>
      <Effects name="child" dep="x" />
      <Effects name="parent" dep />
    </div>
end

let theme = React.createContext "light"

module Theme_provider = struct
  let make = React.Context.provider theme

  external makeProps :
    value:string -> children:React.element -> unit -> < value : string ; children : React.element > Js.t
    = ""
  [@@mel.obj]
end

module Leaf = struct
  let[@react.component] make () =
    let value = React.useContext theme in
    log ("render leaf " ^ value);
    <em>(React.string value)</em>
end

module Middle = struct
  let[@react.component] make = React.memo (fun () ->
    log "render middle";
    <Leaf />)
