# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "The reason-react API for Melange, compiled to templates, without React or a virtual DOM"
maintainer: ["Gleb"]
authors: ["Gleb"]
license: "MIT"
homepage: "https://github.com/jongleb/melact"
bug-reports: "https://github.com/jongleb/melact/issues"
depends: [
  "ocaml" {>= "5.3"}
  "dune" {>= "3.16" & >= "3.16"}
  "melange" {>= "5.1"}
  "melhole"
  "reason-react" {with-test}
  "reason-react-ppx" {with-test}
  "reason" {with-test}
  "mlx" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/jongleb/melact.git"
